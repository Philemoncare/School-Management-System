generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id                       String                    @id @default(uuid())
  name                     String
  code                     String                    @unique
  slug                     String                    @unique
  logo                     String?
  address                  String?
  phone                    String?
  email                    String?
  timezone                 String                    @default("UTC")
  currency                 String                    @default("USD")
  smsCreditBalance         Decimal                   @default(0) @db.Decimal(19, 4) @map("sms_credit_balance")
  status                   SchoolStatus              @default(ACTIVE)
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  academicCalendar         AcademicCalendar[]
  academicYears            AcademicYear[]
  admissionApplications    AdmissionApplication[]
  admissionCampaigns       AdmissionCampaign[]
  admissionOffers          AdmissionOffer[]
  analyticsSnapshots       AnalyticsSnapshot[]
  announcements            Announcement[]
  assessmentTypes          AssessmentType[]
  assessments              Assessment[]
  assets                   Asset[]
  attendanceSessions       AttendanceSession[]
  authors                  Author[]
  bellSchedules            BellSchedule[]
  billingRuns              BillingRun[]
  bookCategories           BookCategory[]
  bookCopies               BookCopy[]
  books                    Book[]
  classAssignments         ClassAssignment[]
  classes                  Class[]
  ClinicVisit              ClinicVisit[]
  communicationCampaigns   CommunicationCampaign[]
  communicationRules       CommunicationRule[]
  usageLogs                CommunicationUsage[]
  communications           Communication[]
  conversations            Conversation[]
  departments              Department[]
  drivers                  Driver[]
  EmergencyBreakGlass      EmergencyBreakGlass[]
  Enrollment               Enrollment[]
  ExaminationPeriod        ExaminationPeriod[]
  featureOverrides         FeatureFlagOverride[]
  feeCategories            FeeCategory[]
  feeStructures            FeeStructure[]
  Adjustments              FinancialAdjustment[]
  fuelRecords              FuelRecord[]
  goodsReceipts            GoodsReceipt[]
  GradingPolicy            GradingPolicy[]
  gradingScales            GradingScale[]
  clinicAppointments       ClinicAppointment[]
  healthDocuments          HealthDocument[]
  firstAidRecords          FirstAidRecord[]
  healthFollowUps          HealthFollowUp[]
  healthIncidents          HealthIncident[]
  healthScreenings         HealthScreening[]
  inventoryBalances        InventoryBalance[]
  inventoryCategories      InventoryCategory[]
  inventoryItems           InventoryItem[]
  inventoryLocations       InventoryLocation[]
  Invitation               Invitation[]
  invoices                 Invoice[]
  leaveRequests            LeaveRequest[]
  leaveTypes               LeaveType[]
  ledgerEntries            LedgerEntry[]
  libraryConfig            LibraryConfiguration?
  libraryFines             LibraryFine[]
  libraryLoans             LibraryLoan[]
  libraryLocations         LibraryLocation[]
  libraryMemberships       LibraryMembership[]
  libraryReservations      LibraryReservation[]
  templates                NotificationTemplate[]
  notifications            Notification[]
  numberingRules           NumberingRule[]
  overallResults           OverallResult[]
  payments                 Payment[]
  platformInvoices         PlatformInvoice[]
  platformPayments         PlatformPayment[]
  smsCreditPurchases       SmsCreditPurchase[]
  positions                Position[]
  PrivacyRequest           PrivacyRequest[]
  PromotionPolicy          PromotionPolicy[]
  publishers               Publisher[]
  purchaseOrders           PurchaseOrder[]
  purchaseRequests         PurchaseRequest[]
  receipts                 Receipt[]
  ReportCard               ReportCard[]
  reportDefinitions        ReportDefinition[]
  reportExecutions         ReportExecution[]
  reportSchedules          ReportSchedule[]
  ResultCorrectionRequest  ResultCorrectionRequest[]
  RetentionPolicy          RetentionPolicy[]
  roles                    Role[]
  roomBookings             RoomBooking[]
  rooms                    Room[]
  routes                   Route[]
  savedSearches            SavedSearch[]
  memberships              SchoolMembership[]
  supportAccessGrants      SupportAccessGrant[]
  schoolSettings           SchoolSetting[]
  subscription             SchoolSubscription?
  searchHistory            SearchHistory[]
  searchIndexes            SearchIndex[]
  SecurityEvent            SecurityEvent[]
  SecurityIncident         SecurityIncident[]
  SecurityPolicy           SecurityPolicy?
  staff                    Staff[]
  staffAttendance          StaffAttendance[]
  offboardings             StaffOffboarding[]
  onboardings              StaffOnboarding[]
  stockMovements           StockMovement[]
  scores                   StudentAssessmentScore[]
  studentAttendance        StudentAttendance[]
  healthProfiles           StudentHealthProfile[]
  students                 Student[]
  subjectResults           SubjectResult[]
  subjects                 Subject[]
  suppliers                Supplier[]
  teacherSubstitutions     TeacherSubstitution[]
  teachers                 Teacher[]
  temporaryScheduleChanges TemporaryScheduleChange[]
  timetableEntries         TimetableEntry[]
  timetableVersions        TimetableVersion[]
  transportAssignments     TransportAssignment[]
  transportEmergencies     TransportEmergency[]
  transportSchedules       TransportSchedule[]
  transportTrips           TransportTrip[]
  userRoles                UserRole[]
  vehicles                 Vehicle[]
  workflowInstances        WorkflowInstance[]
  maintenanceWindows       MaintenanceWindow[]       @relation("MaintenanceWindowToSchool")
  teacherTasks             TeacherTask[]

  @@map("schools")
}

model User {
  id                        String                     @id @default(uuid())
  email                     String                     @unique
  phone                     String?                    @unique
  passwordHash              String
  firstName                 String                     @map("first_name")
  lastName                  String                     @map("last_name")
  isActive                  Boolean                    @default(true) @map("is_active")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  emailVerified             DateTime?                  @map("email_verified")
  phoneVerified             DateTime?                  @map("phone_verified")
  accountState              AccountState               @default(PENDING_VERIFICATION) @map("account_state")
  assignedApplications      AdmissionApplication[]     @relation("AssignedApplications")
  assessments               AdmissionAssessment[]
  decisions                 AdmissionDecision[]
  interviews                AdmissionInterview[]
  announcements             Announcement[]             @relation("AuthorAnnouncements")
  issuedAssetAssignments    AssetAssignment[]
  approvedAssetDisposals    AssetDisposal[]
  reportedAssetMaintenances AssetMaintenance[]
  clinicVisits              ClinicVisit[]
  communicationApprovals    CommunicationApproval[]
  communicationRecipients   CommunicationRecipient[]
  sentCommunications        Communication[]            @relation("AuthorCommunications")
  conversationLinks         ConversationParticipant[]
  breakGlassLogs            EmergencyBreakGlass[]
  invigilatedSessions       ExaminationSession[]
  goodsReceipts             GoodsReceipt[]
  guardianProfile           Guardian?
  carePlanVersions          HealthCarePlanVersion[]
  bookedAppointments        ClinicAppointment[]
  healthConsents            HealthConsent[]
  uploadedHealthDocs        HealthDocument[]
  assignedHealthFollowUps   HealthFollowUp[]
  reportedHealthIncidents   HealthIncident[]
  libraryMemberships        LibraryMembership[]
  medicationAdministrations MedicationAdministration[]
  messageReceipts           MessageReadStatus[]
  sentMessages              Message[]                  @relation("SentMessages")
  MfaMethod                 MfaMethod[]
  notificationPrefs         NotificationPreference[]
  notifications             Notification[]
  platformSettingVersions   PlatformSettingVersion[]
  PrivacyRequest            PrivacyRequest[]
  purchaseRequests          PurchaseRequest[]
  reportExecutions          ReportExecution[]
  reportSchedules           ReportSchedule[]
  ReportVersion             ReportVersion[]
  requestedCorrections      ResultCorrectionRequest[]  @relation("RequestedCorrections")
  reviewedCorrections       ResultCorrectionRequest[]  @relation("ReviewedCorrections")
  roomBookings              RoomBooking[]
  savedSearches             SavedSearch[]
  memberships               SchoolMembership[]
  requestedSupportGrants    SupportAccessGrant[]        @relation("SupportGrantRequester")
  approvedSupportGrants     SupportAccessGrant[]        @relation("SupportGrantApprover")
  createdPlatformBackups    PlatformBackup[]            @relation("PlatformBackupCreator")
  schoolSettingVersions     SchoolSettingVersion[]
  searchHistory             SearchHistory[]
  SecurityEvent             SecurityEvent[]
  staffProfile              Staff?
  stockMovements            StockMovement[]
  studentProfile            Student?
  teacherProfile            Teacher?
  UserDevice                UserDevice[]
  userPreferences           UserPreference[]
  userRoles                 UserRole[]
  UserSession               UserSession[]
  recordedVitals            VitalSign[]
  teacherTasksAssignedBy    TeacherTask[]   @relation("TeacherTaskAssignedBy")
  teacherTasksAssignedTo    TeacherTask[]   @relation("TeacherTaskAssignedTo")

  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model Invitation {
  id          String           @id @default(uuid())
  schoolId    String           @map("school_id")
  email       String
  roleId      String           @map("role_id")
  tokenHash   String           @unique @map("token_hash")
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at")
  invitedById String           @map("invited_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  role        Role             @relation(fields: [roleId], references: [id])
  school      School           @relation(fields: [schoolId], references: [id])

  @@map("invitations")
}

model SchoolMembership {
  id        String           @id @default(uuid())
  schoolId  String           @map("school_id")
  userId    String           @map("user_id")
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  school    School           @relation(fields: [schoolId], references: [id])
  user      User             @relation(fields: [userId], references: [id])

  @@unique([schoolId, userId])
  @@map("school_memberships")
}

model Role {
  id                    String                 @id @default(uuid())
  name                  String
  description           String?
  isSystem              Boolean                @default(false) @map("is_system")
  schoolId              String?                @map("school_id")
  announcementAudiences AnnouncementAudience[]
  Invitation            Invitation[]
  permissions           RolePermission[]
  school                School?                @relation(fields: [schoolId], references: [id])
  userRoles             UserRole[]

  @@unique([name, schoolId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id       String  @id @default(uuid())
  userId   String  @map("user_id")
  roleId   String  @map("role_id")
  schoolId String? @map("school_id")
  role     Role    @relation(fields: [roleId], references: [id])
  school   School? @relation(fields: [schoolId], references: [id])
  user     User    @relation(fields: [userId], references: [id])

  @@unique([userId, roleId, schoolId])
  @@map("user_roles")
}

model Student {
  id                         String                      @id @default(uuid())
  schoolId                   String                      @map("school_id")
  userId                     String?                     @unique @map("user_id")
  firstName                  String                      @map("first_name")
  middleName                 String?                     @map("middle_name")
  lastName                   String                      @map("last_name")
  studentNumber              String                      @map("student_number")
  admissionNumber            String?                     @map("admission_number")
  admissionDate              DateTime                    @map("admission_date")
  dateOfBirth                DateTime                    @map("date_of_birth")
  gender                     String?
  status                     StudentStatus               @default(ACTIVE)
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  announcementAudiences      AnnouncementAudience[]
  classAssignmentSubmissions ClassAssignmentSubmission[]
  EmergencyBreakGlass        EmergencyBreakGlass[]
  enrollments                Enrollment[]
  ExaminationAttendance      ExaminationAttendance[]
  adjustments                FinancialAdjustment[]
  invoices                   Invoice[]
  ledgerEntries              LedgerEntry[]
  overallResults             OverallResult[]
  payments                   Payment[]
  receipts                   Receipt[]
  ReportCard                 ReportCard[]
  ResultCorrectionRequest    ResultCorrectionRequest[]
  scores                     StudentAssessmentScore[]
  attendance                 StudentAttendance[]
  guardians                  StudentGuardian[]
  healthProfile              StudentHealthProfile?
  school                     School                      @relation(fields: [schoolId], references: [id])
  user                       User?                       @relation(fields: [userId], references: [id])
  subjectResults             SubjectResult[]
  transportAssignments       TransportAssignment[]
  transportAttendances       TransportAttendance[]

  @@unique([schoolId, studentNumber])
  @@unique([schoolId, admissionNumber])
  @@index([schoolId, status])
  @@index([studentNumber])
  @@map("students")
}

model Guardian {
  id        String            @id @default(uuid())
  userId    String?           @unique @map("user_id")
  firstName String            @map("first_name")
  lastName  String            @map("last_name")
  email     String?
  phone     String?
  address   String?
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  user      User?             @relation(fields: [userId], references: [id])
  students  StudentGuardian[]

  @@map("guardians")
}

model StudentGuardian {
  studentId  String   @map("student_id")
  guardianId String   @map("guardian_id")
  relation   String
  isPrimary  Boolean  @default(false) @map("is_primary")
  guardian   Guardian @relation(fields: [guardianId], references: [id])
  student    Student  @relation(fields: [studentId], references: [id])

  @@id([studentId, guardianId])
  @@map("student_guardians")
}

model Teacher {
  id                      String                    @id @default(uuid())
  schoolId                String                    @map("school_id")
  userId                  String?                   @unique @map("user_id")
  firstName               String                    @map("first_name")
  middleName              String?                   @map("middle_name")
  lastName                String                    @map("last_name")
  employeeId              String?                   @map("employee_id")
  specialization          String?
  status                  StaffStatus               @default(ACTIVE)
  departmentId            String?                   @map("department_id")
  positionId              String?                   @map("position_id")
  dateOfBirth             DateTime?                 @map("date_of_birth")
  gender                  String?
  address                 String?
  nationalId              String?                   @map("national_id")
  dateOfJoining           DateTime?                 @map("date_of_joining")
  yearsOfExperience       Int?
  emergencyContactName    String?                   @map("emergency_contact_name")
  emergencyContactPhone   String?                   @map("emergency_contact_phone")
  bankAccountName         String?                   @map("bank_account_name")
  bankAccountNumber       String?                   @map("bank_account_number")
  bankName                String?                   @map("bank_name")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  attendanceSessions      AttendanceSession[]
  classAssignments        ClassAssignment[]
  headOfDepartments       Department[]              @relation("DepartmentHeadTeacher")
  disciplinaryRecords     DisciplinaryRecord[]
  leaveBalances           LeaveBalance[]
  leaveRequests           LeaveRequest[]
  performanceReviews      PerformanceReview[]
  staffAttendance         StaffAttendance[]
  certifications          StaffCertification[]
  documents               StaffDocument[]
  employmentRecords       StaffEmployment[]
  offboarding             StaffOffboarding?
  onboarding              StaffOnboarding?
  qualifications          StaffQualification[]
  schedules               StaffSchedule[]
  assignments             TeacherAssignment[]
  availability            TeacherAvailability[]
  originalSubstitutions   TeacherSubstitution[]     @relation("OriginalTeacher")
  substituteSubstitutions TeacherSubstitution[]     @relation("SubstituteTeacher")
  department              Department?               @relation("TeacherDepartment", fields: [departmentId], references: [id])
  position                Position?                 @relation(fields: [positionId], references: [id])
  school                  School                    @relation(fields: [schoolId], references: [id])
  user                    User?                     @relation(fields: [userId], references: [id])
  temporaryChanges        TemporaryScheduleChange[]
  timetableEntries        TimetableEntry[]

  @@unique([schoolId, employeeId])
  @@map("teachers")
}

model Staff {
  id                  String                    @id @default(uuid())
  schoolId            String                    @map("school_id")
  userId              String?                   @unique @map("user_id")
  firstName           String                    @map("first_name")
  middleName          String?                   @map("middle_name")
  lastName            String                    @map("last_name")
  employeeId          String?                   @map("employee_id")
  designation         String?
  status              StaffStatus               @default(ACTIVE)
  departmentId        String?                   @map("department_id")
  positionId          String?                   @map("position_id")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  AssetAssignment     AssetAssignment[]
  Asset               Asset[]
  headOfDepartments   Department[]              @relation("DepartmentHeadStaff")
  disciplinaryRecords DisciplinaryRecord[]
  driver              Driver?
  InventoryLocation   InventoryLocation[]
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  performanceReviews  PerformanceReview[]
  department          Department?               @relation("StaffDepartment", fields: [departmentId], references: [id])
  position            Position?                 @relation(fields: [positionId], references: [id])
  school              School                    @relation(fields: [schoolId], references: [id])
  user                User?                     @relation(fields: [userId], references: [id])
  staffAttendance     StaffAttendance[]
  certifications      StaffCertification[]
  documents           StaffDocument[]
  employmentRecords   StaffEmployment[]
  offboarding         StaffOffboarding?
  onboarding          StaffOnboarding?
  qualifications      StaffQualification[]
  schedules           StaffSchedule[]
  temporaryChanges    TemporaryScheduleChange[]

  @@unique([schoolId, employeeId])
  @@map("staff")
}

model AcademicYear {
  id                   String                 @id @default(uuid())
  schoolId             String                 @map("school_id")
  name                 String
  code                 String
  startDate            DateTime               @map("start_date")
  endDate              DateTime               @map("end_date")
  isCurrent            Boolean                @default(false) @map("is_current")
  status               AcademicYearStatus     @default(UPCOMING)
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  AcademicCalendar     AcademicCalendar[]
  school               School                 @relation(fields: [schoolId], references: [id])
  AdmissionApplication AdmissionApplication[]
  AdmissionCampaign    AdmissionCampaign[]
  AdmissionOffer       AdmissionOffer[]
  assessments          Assessment[]
  attendanceSessions   AttendanceSession[]
  BellSchedule         BellSchedule[]
  classAssignments     ClassAssignment[]
  enrollments          Enrollment[]
  ExaminationPeriod    ExaminationPeriod[]
  feeStructures        FeeStructure[]
  invoices             Invoice[]
  overallResults       OverallResult[]
  ReportCard           ReportCard[]
  subjectResults       SubjectResult[]
  teacherAssignments   TeacherAssignment[]
  terms                Term[]
  timetableEntries     TimetableEntry[]
  TimetableVersion     TimetableVersion[]
  teacherTasks         TeacherTask[]

  @@unique([schoolId, code])
  @@map("academic_years")
}

model Term {
  id                 String              @id @default(uuid())
  academicYearId     String              @map("academic_year_id")
  name               String
  code               String
  sequence           Int
  startDate          DateTime            @map("start_date")
  endDate            DateTime            @map("end_date")
  status             TermStatus          @default(UPCOMING)
  AcademicCalendar   AcademicCalendar[]
  assessments        Assessment[]
  attendanceSessions AttendanceSession[]
  BellSchedule       BellSchedule[]
  classAssignments   ClassAssignment[]
  enrollments        Enrollment[]
  ExaminationPeriod  ExaminationPeriod[]
  feeStructures      FeeStructure[]
  invoices           Invoice[]
  overallResults     OverallResult[]
  ReportCard         ReportCard[]
  subjectResults     SubjectResult[]
  teacherAssignments TeacherAssignment[]
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])
  timetableEntries   TimetableEntry[]
  TimetableVersion   TimetableVersion[]
  teacherTasks       TeacherTask[]

  @@unique([academicYearId, code])
  @@unique([academicYearId, sequence])
  @@map("terms")
}

model Class {
  id                    String                 @id @default(uuid())
  schoolId              String                 @map("school_id")
  name                  String
  code                  String
  level                 Int                    @default(0)
  description           String?
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  AdmissionApplication  AdmissionApplication[]
  AdmissionOffer        AdmissionOffer[]
  AdmissionWaitlist     AdmissionWaitlist[]
  announcementAudiences AnnouncementAudience[]
  assessments           Assessment[]
  attendanceSessions    AttendanceSession[]
  classAssignments      ClassAssignment[]
  classSubjects         ClassSubject[]
  school                School                 @relation(fields: [schoolId], references: [id])
  enrollments           Enrollment[]
  ExaminationSession    ExaminationSession[]
  feeStructures         FeeStructure[]
  invoices              Invoice[]
  overallResults        OverallResult[]
  ReportCard            ReportCard[]
  sections              Section[]
  subjectResults        SubjectResult[]
  timetableEntries      TimetableEntry[]
  teacherTasks          TeacherTask[]

  @@unique([schoolId, code])
  @@map("classes")
}

model Section {
  id                    String                 @id @default(uuid())
  classId               String                 @map("class_id")
  name                  String
  code                  String
  capacity              Int?
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  announcementAudiences AnnouncementAudience[]
  assessments           Assessment[]
  attendanceSessions    AttendanceSession[]
  classSubjects         ClassSubject[]
  enrollments           Enrollment[]
  ExaminationSession    ExaminationSession[]
  feeStructures         FeeStructure[]
  invoices              Invoice[]
  overallResults        OverallResult[]
  class                 Class                  @relation(fields: [classId], references: [id])
  subjectResults        SubjectResult[]
  teacherAssignments    TeacherAssignment[]
  timetableEntries      TimetableEntry[]
  teacherTasks          TeacherTask[]

  @@unique([classId, code])
  @@map("sections")
}

model Subject {
  id                              String                            @id @default(uuid())
  schoolId                        String                            @map("school_id")
  name                            String
  code                            String
  shortName                       String?                           @map("short_name")
  description                     String?
  subjectType                     SubjectType                       @default(CORE) @map("subject_type")
  isActive                        Boolean                           @default(true) @map("is_active")
  createdAt                       DateTime                          @default(now()) @map("created_at")
  updatedAt                       DateTime                          @updatedAt @map("updated_at")
  assessments                     Assessment[]
  attendanceSessions              AttendanceSession[]
  classAssignments                ClassAssignment[]
  classSubjects                   ClassSubject[]
  ExaminationSession              ExaminationSession[]
  feeStructures                   FeeStructure[]
  invoices                        Invoice[]
  ReportCardSubjectResultSnapshot ReportCardSubjectResultSnapshot[]
  subjectResults                  SubjectResult[]
  school                          School                            @relation(fields: [schoolId], references: [id])
  teacherAssignments              TeacherAssignment[]
  timetableEntries                TimetableEntry[]
  teacherTasks                    TeacherTask[]

  @@unique([schoolId, code])
  @@map("subjects")
}

model ClassSubject {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  classId   String   @map("class_id")
  sectionId String?  @map("section_id")
  subjectId String   @map("subject_id")
  class     Class    @relation(fields: [classId], references: [id])
  section   Section? @relation(fields: [sectionId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])

  @@unique([classId, sectionId, subjectId])
  @@map("class_subjects")
}

model AssessmentType {
  id          String             @id @default(uuid())
  schoolId    String?            @map("school_id")
  name        String
  code        String
  description String?
  category    AssessmentCategory @default(CONTINUOUS_ASSESSMENT)
  isActive    Boolean            @default(true) @map("is_active")
  school      School?            @relation(fields: [schoolId], references: [id])
  assessments Assessment[]

  @@unique([schoolId, code])
  @@map("assessment_types")
}

model Assessment {
  id               String                   @id @default(uuid())
  schoolId         String                   @map("school_id")
  academicYearId   String                   @map("academic_year_id")
  termId           String?                  @map("term_id")
  assessmentTypeId String                   @map("assessment_type_id")
  name             String
  code             String
  description      String?
  classId          String                   @map("class_id")
  sectionId        String?                  @map("section_id")
  subjectId        String                   @map("subject_id")
  totalMarks       Float                    @map("total_marks")
  weight           Float                    @default(1.0)
  startDate        DateTime?                @map("start_date")
  endDate          DateTime?                @map("end_date")
  status           AssessmentStatus         @default(DRAFT)
  examPeriodId     String?                  @map("exam_period_id")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  createdBy        String?                  @map("created_by")
  components       AssessmentComponent[]
  academicYear     AcademicYear             @relation(fields: [academicYearId], references: [id])
  assessmentType   AssessmentType           @relation(fields: [assessmentTypeId], references: [id])
  class            Class                    @relation(fields: [classId], references: [id])
  examPeriod       ExaminationPeriod?       @relation(fields: [examPeriodId], references: [id])
  school           School                   @relation(fields: [schoolId], references: [id])
  section          Section?                 @relation(fields: [sectionId], references: [id])
  subject          Subject                  @relation(fields: [subjectId], references: [id])
  term             Term?                    @relation(fields: [termId], references: [id])
