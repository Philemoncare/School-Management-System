// GRADING
// -----------------------------------------------------------------------------

model GradingScale {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  policyId    String?  @map("policy_id")
  name        String
  code        String
  description String?
  status      Boolean  @default(true)

  school      School   @relation(fields: [schoolId], references: [id])
  policy      GradingPolicy? @relation(fields: [policyId], references: [id])
  gradeBands  GradeBand[]

  @@unique([schoolId, code])
  @@map("grading_scales")
}

model GradeBand {
  id               String   @id @default(uuid())
  gradingScaleId   String   @map("school_id")
  gradepoint       Float?   @map("grade_point")
  minimumPercentage Float    @map("minimum_percentage")
  maximumPercentage Float    @map("maximum_percentage")
  grade            String
  remark           String?
  sequence         Int      @default(0)

  gradingScale     GradingScale @relation(fields: [gradingScaleId], references: [id])

  @@map("grade_bands")
}

// -----------------------------------------------------------------------------
// RESULTS & REPORT CARDS
// -----------------------------------------------------------------------------

model SubjectResult {
  id               String   @id @default(uuid())
  schoolId         String   @map("school_id")
  academicYearId   String   @map("academic_year_id")
  termId           String?  @map("term_id")
  enrollmentId     String   @map("enrollment_id")
  studentId        String   @map("student_id")
  subjectId        String   @map("subject_id")
  classId          String   @map("class_id")
  sectionId        String?  @map("section_id")
  weightedScore    Float    @map("weighted_score")
  percentage       Float
  grade            String
  gradePoint       Float?   @map("grade_point")
  remark           String?
  status           ResultStatus @default(DRAFT)

  school           School       @relation(fields: [schoolId], references: [id])
  academicYear     AcademicYear @relation(fields: [academicYearId], references: [id])
  term             Term?        @relation(fields: [termId], references: [id])
  enrollment       Enrollment   @relation(fields: [enrollmentId], references: [id])
  student          Student      @relation(fields: [studentId], references: [id])
  subject          Subject      @relation(fields: [subjectId], references: [id])
  class            Class        @relation(fields: [classId], references: [id])
  section          Section?     @relation(fields: [sectionId], references: [id])

  calculatedAt     DateTime @default(now()) @map("calculated_at")
  approvedAt       DateTime? @map("approved_at")
  publishedAt      DateTime? @map("published_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([enrollmentId, subjectId])
  @@map("subject_results")
}

model OverallResult {
  id               String   @id @default(uuid())
  schoolId         String   @map("school_id")
  academicYearId   String   @map("academic_year_id")
  termId           String?  @map("term_id")
  enrollmentId     String   @map("enrollment_id")
  studentId        String   @map("student_id")
  classId          String   @map("class_id")
  sectionId        String?  @map("section_id")
  totalScore       Float    @map("total_score")
  averagePercentage Float   @map("average_percentage")
  totalGradePoints Float?   @map("total_grade_points")
  averageGradePoint Float?  @map("average_grade_point")
  position         Int?
  totalStudents    Int?     @map("total_students")
  remark           String?
  status           ResultStatus @default(DRAFT)

  school           School       @relation(fields: [schoolId], references: [id])
  academicYear     AcademicYear @relation(fields: [academicYearId], references: [id])
  term             Term?        @relation(fields: [termId], references: [id])
  enrollment       Enrollment   @relation(fields: [enrollmentId], references: [id])
  student          Student      @relation(fields: [studentId], references: [id])
  class            Class        @relation(fields: [classId], references: [id])
  section          Section?     @relation(fields: [sectionId], references: [id])

  calculatedAt     DateTime @default(now()) @map("calculated_at")
  approvedAt       DateTime? @map("approved_at")
  publishedAt      DateTime? @map("published_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([enrollmentId, academicYearId, termId])
  @@map("overall_results")
}

model ResultCorrectionRequest {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  subjectResultId String   @map("subject_result_id")
  studentId       String   @map("student_id")

  requestedById   String   @map("requested_by_id")
  reason          String   @db.Text

  previousScore   Float    @map("previous_score")
  newScore        Float    @map("new_score")

  status          CorrectionStatus @default(PENDING)
  reviewedById    String?  @map("reviewed_by_id")
  reviewedAt      DateTime? @map("reviewed_at")

  school          School        @relation(fields: [schoolId], references: [id])
  subjectResult   SubjectResult @relation(fields: [subjectResultId], references: [id])
  student         Student       @relation(fields: [studentId], references: [id])
  requestedBy     User          @relation("RequestedCorrections", fields: [requestedById], references: [id])
  reviewedBy      User?         @relation("ReviewedCorrections", fields: [reviewedById], references: [id])

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("result_correction_requests")
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  IMPLEMENTED
}

model ReportCard {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  studentId       String   @map("student_id")
  academicYearId  String   @map("academic_year_id")
  termId          String?  @map("term_id")
  classId         String   @map("class_id")

  overallScore    Float?   @map("overall_score")
  averagePercentage Float? @map("average_percentage")
  gpa             Float?
  rank            Int?

  teacherComment  String?  @db.Text
  principalComment String? @db.Text
  attendanceDays  Int?     @map("attendance_days")
  totalTeachingDays Int?    @map("total_teaching_days")

  status          ReportCardStatus @default(DRAFT)
  fileUrl         String?  @map("file_url")
  publishedAt     DateTime? @map("published_at")

  school          School       @relation(fields: [schoolId], references: [id])
  student         Student      @relation(fields: [studentId], references: [id])
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id])
  term            Term?        @relation(fields: [termId], references: [id])
  class           Class        @relation(fields: [classId], references: [id])

  subjectSnapshots ReportCardSubjectResultSnapshot[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([studentId, academicYearId, termId])
  @@map("report_cards")
}

enum ReportCardStatus {
  DRAFT
  GENERATED
  PUBLISHED
  LOCKED
}

model ReportCardSubjectResultSnapshot {
  id              String   @id @default(uuid())
  reportCardId    String   @map("report_card_id")
  subjectId       String   @map("subject_id")

  score           Float
  grade           String
  gradePoint      Float?   @map("grade_point")
  rank            Int?
  teacherComment  String?  @db.Text

  reportCard      ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  subject         Subject    @relation(fields: [subjectId], references: [id])

  @@unique([reportCardId, subjectId])
  @@map("report_card_subject_snapshots")
}

model GradingPolicy {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  name            String
  description     String?
  isDefault       Boolean  @default(false) @map("is_default")

  calculationRules Json?    // Weighting methods, rounding, etc.

  school          School   @relation(fields: [schoolId], references: [id])
  scales          GradingScale[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("grading_policies")
}

model PromotionPolicy {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  name            String
  description     String?
  isActive        Boolean  @default(true) @map("is_active")

  rules           PromotionRule[]

  school          School   @relation(fields: [schoolId], references: [id])

  @@map("promotion_policies")
}

model PromotionRule {
  id              String   @id @default(uuid())
  policyId        String   @map("policy_id")

  criterion       String   // e.g. MIN_AVERAGE, PASS_CORE_SUBJECTS
  value           String

  policy          PromotionPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@map("promotion_rules")
}

enum ResultStatus {
  DRAFT
  CALCULATED
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  LOCKED
  WITHDRAWN
}

// -----------------------------------------------------------------------------
// FINANCE & FEES
// -----------------------------------------------------------------------------

model FeeCategory {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")

  school      School   @relation(fields: [schoolId], references: [id])
  feeStructures FeeStructure[]
  invoiceItems  InvoiceItem[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, code])
  @@map("fee_categories")
}

model FeeStructure {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  academicYearId String   @map("academic_year_id")
  termId         String?  @map("term_id")
  classId        String?  @map("class_id")
  sectionId      String?  @map("section_id")
  subjectId      String?  @map("subject_id")
  feeCategoryId  String   @map("fee_category_id")
  name           String
  amount         Decimal  @db.Decimal(19, 4)
  currency       String   @default("USD")
  dueDate        DateTime @map("due_date")
  isMandatory    Boolean  @default(true) @map("is_mandatory")
  status         FeeStructureStatus @default(ACTIVE)

  school         School       @relation(fields: [schoolId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  term           Term?        @relation(fields: [termId], references: [id])
  class          Class?       @relation(fields: [classId], references: [id])
  section        Section?     @relation(fields: [sectionId], references: [id])
  subject        Subject?     @relation(fields: [subjectId], references: [id])
  feeCategory    FeeCategory  @relation(fields: [feeCategoryId], references: [id])

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("fee_structures")
}

model Invoice {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  studentId      String   @map("student_id")
  enrollmentId   String   @map("enrollment_id")
  academicYearId String   @map("academic_year_id")
  termId         String?  @map("term_id")
  classId        String?  @map("class_id")
  sectionId      String?  @map("section_id")
  subjectId      String?  @map("subject_id")
  invoiceNumber  String   @map("invoice_number")
  issueDate      DateTime @default(now()) @map("issue_date")
  dueDate        DateTime @map("due_date")
  currency       String   @default("USD")
  subtotal       Decimal  @db.Decimal(19, 4)
  discountTotal  Decimal  @default(0) @db.Decimal(19, 4) @map("discount_total")
  totalAmount    Decimal  @db.Decimal(19, 4) @map("total_amount")
  amountPaid     Decimal  @default(0) @db.Decimal(19, 4) @map("amount_paid")
  balance        Decimal  @db.Decimal(19, 4)
  status         InvoiceStatus @default(DRAFT)

  school         School       @relation(fields: [schoolId], references: [id])
  student        Student      @relation(fields: [studentId], references: [id])
  enrollment     Enrollment   @relation(fields: [enrollmentId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  term           Term?        @relation(fields: [termId], references: [id])
  class          Class?       @relation(fields: [classId], references: [id])
  section        Section?     @relation(fields: [sectionId], references: [id])
  subject        Subject?     @relation(fields: [subjectId], references: [id])

  items          InvoiceItem[]
  allocations    PaymentAllocation[]
  adjustments    FinancialAdjustment[]

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by")

  @@unique([schoolId, invoiceNumber])
  @@index([schoolId, status])
  @@index([studentId])
  @@index([dueDate])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  CANCELLED
}

enum FeeStructureStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

model InvoiceItem {
  id             String   @id @default(uuid())
  invoiceId      String   @map("invoice_id")
  feeCategoryId  String   @map("fee_category_id")
  description    String
  quantity       Int      @default(1)
  unitAmount     Decimal  @db.Decimal(19, 4) @map("unit_amount")
  discountAmount Decimal  @default(0) @db.Decimal(19, 4) @map("discount_amount")
  totalAmount    Decimal  @db.Decimal(19, 4) @map("total_amount")

  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeCategory    FeeCategory  @relation(fields: [feeCategoryId], references: [id])

  @@map("invoice_items")
}

model Payment {
  id                String   @id @default(uuid())
  schoolId          String   @map("school_id")
  studentId         String   @map("student_id")
  paymentReference  String   @unique @map("payment_reference")
  externalReference String?  @map("external_reference")
  amount            Decimal  @db.Decimal(19, 4)
  currency          String   @default("USD")
  paymentMethod     PaymentMethod @map("payment_method")
  status            PaymentStatus @default(PENDING)
  paymentDate       DateTime @default(now()) @map("payment_date")

  school            School      @relation(fields: [schoolId], references: [id])
  student           Student     @relation(fields: [studentId], references: [id])
  allocations       PaymentAllocation[]
  receipts          Receipt[]
  refunds           Refund[]

  verifiedAt        DateTime? @map("verified_at")
  verifiedBy        String?   @map("verified_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("payments")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  CHEQUE
  ONLINE_PAYMENT
  OTHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

model PaymentAllocation {
  id         String   @id @default(uuid())
  paymentId  String   @map("payment_id")
  invoiceId  String   @map("invoice_id")
  amount     Decimal  @db.Decimal(19, 4)

  payment    Payment  @relation(fields: [paymentId], references: [id])
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])

  createdAt  DateTime @default(now()) @map("created_at")

  @@map("payment_allocations")
}

model Receipt {
  id               String   @id @default(uuid())
  schoolId         String   @map("school_id")
  studentId        String   @map("student_id")
  paymentId        String   @map("payment_id")
  receiptNumber    String   @map("receipt_number")
  amount           Decimal  @db.Decimal(19, 4)
  currency         String
  paymentMethod    PaymentMethod @map("payment_method")
  paymentDate      DateTime @map("payment_date")
  issuedBy         String?  @map("issued_by")

  school           School   @relation(fields: [schoolId], references: [id])
  student          Student  @relation(fields: [studentId], references: [id])
  payment          Payment  @relation(fields: [paymentId], references: [id])

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, receiptNumber])
  @@map("receipts")
}

model LedgerEntry {
  id               String   @id @default(uuid())
  schoolId         String   @map("school_id")
  studentId        String?  @map("student_id")
  transactionType  LedgerTransactionType @map("transaction_type")
  amount           Decimal  @db.Decimal(19, 4)
  currency         String
  direction        LedgerDirection
  description      String?
  referenceId      String?  @map("reference_id") // ID of Invoice, Payment, Adjustment, etc.
  referenceType    String?  @map("reference_type")
  actorId          String?  @map("actor_id")

  school           School   @relation(fields: [schoolId], references: [id])
  student          Student? @relation(fields: [studentId], references: [id])

  createdAt        DateTime @default(now()) @map("created_at")

  @@map("ledger_entries")
}

enum LedgerTransactionType {
  INVOICE
  PAYMENT
  DISCOUNT
  SCHOLARSHIP
  WAIVER
  REFUND
  ADJUSTMENT
  REVERSAL
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

model FinancialAdjustment {
  id               String   @id @default(uuid())
  schoolId         String   @map("school_id")
  studentId        String   @map("student_id")
  invoiceId        String?  @map("invoice_id")
  type             AdjustmentType
  amount           Decimal  @db.Decimal(19, 4)
  currency         String
  reason           String
  status           AdjustmentStatus @default(PENDING)
  approvedBy       String?  @map("approved_by")
  approvedAt       DateTime? @map("approved_at")
  createdBy        String   @map("created_by")

  school           School   @relation(fields: [schoolId], references: [id])
  student          Student  @relation(fields: [studentId], references: [id])
  invoice          Invoice? @relation(fields: [invoiceId], references: [id])

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("financial_adjustments")
}

enum AdjustmentType {
  DISCOUNT
  SCHOLARSHIP
  WAIVER
  CREDIT_ADJUSTMENT
  DEBIT_ADJUSTMENT
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
  POSTED
}

model Refund {
  id               String   @id @default(uuid())
  schoolId         String   @map("school_id")
  paymentId        String   @map("payment_id")
  amount           Decimal  @db.Decimal(19, 4)
  currency         String
  reason           String
  status           RefundStatus @default(PENDING)
  approvedBy       String?  @map("approved_by")
  approvedAt       DateTime? @map("approved_at")
  createdBy        String   @map("created_by")

  payment          Payment  @relation(fields: [paymentId], references: [id])

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("refunds")
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

model BillingRun {
  id               String   @id @default(uuid())
  schoolId         String   @map("school_id")
  academicYearId   String   @map("academic_year_id")
  termId           String?  @map("term_id")
  status           BillingRunStatus @default(PENDING)
  criteria         Json?    // classId, studentIds, etc.

  studentsProcessed Int     @default(0) @map("students_processed")
  invoicesGenerated Int     @default(0) @map("invoices_generated")
  failures         Int      @default(0)
  errorSummary     String?  @map("error_summary")

  createdBy        String   @map("created_by")
  startTime        DateTime? @map("start_time")
  completionTime   DateTime? @map("completion_time")

  school           School   @relation(fields: [schoolId], references: [id])

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("billing_runs")
}

enum BillingRunStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  CANCELLED
}

