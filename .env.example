# Database
DATABASE_URL="postgresql://user:password@localhost:5432/school_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Security
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-random-refresh-secret"
ARGON2_SECRET="replace-with-a-random-argon2-secret"
SKIP_EMAIL_VERIFICATION="false"

# Super Admin Bootstrap
SUPER_ADMIN_EMAIL="admin@schoolma.app"
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_RESET_PASSWORD="false"

# Seed data
SEED_ADMIN_PASSWORD=""

# App
NODE_ENV="development"
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
API_URL="http://localhost:4000"
API_INTERNAL_URL="http://127.0.0.1:4000"
NEXT_PUBLIC_API_URL="/api/v1"

# Storage
STORAGE_BUCKET="school-assets"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="minio-access-key"
STORAGE_SECRET_KEY="minio-secret-key"
STORAGE_ENDPOINT="http://localhost:9000"

# Notification Providers
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

SENDGRID_API_KEY=""
EMAIL_FROM="noreply@school.com"

# SMTP (used when SMTP_HOST, SMTP_USER, and SMTP_PASS are set)
# Use port 465 with SMTP_SECURE=true when your network blocks STARTTLS on 587.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# SMS gateway (Arkesel). Sends use the v2 REST API; the balance read uses the
# legacy action endpoint because Arkesel answers no v2 balance route.
# ARKESEL_SENDER_ID must be a sender ID approved on the Arkesel account, or
# every send is rejected with HTTP 403.
ARKESEL_API_KEY=""
ARKESEL_SANDBOX_API_KEY=""
ARKESEL_SENDER_ID=""
# Expands national-format numbers (0599811870) into MSISDN (233599811870).
# Ghana is 233; leave blank to require international format on every contact.
ARKESEL_DEFAULT_COUNTRY_CODE="233"
ARKESEL_BASE_URL="https://sms.arkesel.com"
SMS_TIMEOUT_MS="20000"

# Sign-in codes sent by text are paid for from the platform's own Arkesel
# wallet, so they are capped to blunt SMS-pumping. Each ceiling counts sends in
# its own window; the hourly total is a hard stop on spend regardless of how many
# distinct numbers or IPs are used.
OTP_SMS_MAX_PER_NUMBER="3"
OTP_SMS_MAX_PER_IP="8"
OTP_SMS_MAX_TOTAL_PER_HOUR="300"

# Payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
