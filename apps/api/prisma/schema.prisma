// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// PLATFORM & TENANCY
// -----------------------------------------------------------------------------

model School {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  slug        String   @unique
  logo        String?

  // Contact Info
  address     String?
  phone       String?
  email       String?

  // Settings
  timezone    String   @default("UTC")
  currency    String   @default("USD")
  status      SchoolStatus @default(ACTIVE)

  // Relations
  memberships SchoolMembership[]
  roles       Role[]
  userRoles   UserRole[]
  students    Student[]
  teachers    Teacher[]
  staff       Staff[]
  academicYears AcademicYear[]
  classes     Class[]
  subjects    Subject[]
  attendanceSessions AttendanceSession[]
  studentAttendance StudentAttendance[]
  assessmentTypes AssessmentType[]
  assessments     Assessment[]
  scores          StudentAssessmentScore[]
  gradingScales   GradingScale[]
  subjectResults  SubjectResult[]
  overallResults  OverallResult[]
  feeCategories   FeeCategory[]
  feeStructures   FeeStructure[]
  invoices        Invoice[]
  payments        Payment[]
  receipts        Receipt[]
  ledgerEntries   LedgerEntry[]
  adjustments     FinancialAdjustment[]
  billingRuns     BillingRun[]

  // Library & Transport
  libraryConfig   LibraryConfiguration?
  bookCategories  BookCategory[]
  authors         Author[]
  publishers      Publisher[]
  books           Book[]
  bookCopies      BookCopy[]
  libraryLocations LibraryLocation[]
  libraryMemberships LibraryMembership[]
  libraryLoans    LibraryLoan[]
  libraryReservations LibraryReservation[]
  libraryFines    LibraryFine[]

  vehicles        Vehicle[]
  drivers         Driver[]
  routes          Route[]
  transportSchedules TransportSchedule[]
  transportAssignments TransportAssignment[]
  transportTrips     TransportTrip[]
  transportEmergencies TransportEmergency[]
  fuelRecords        FuelRecord[]

  // HR
  departments        Department[]
  positions          Position[]
  leaveTypes         LeaveType[]
  leaveRequests      LeaveRequest[]
  staffAttendance    StaffAttendance[]
  onboardings        StaffOnboarding[]
  offboardings       StaffOffboarding[]

  // Admissions
  admissionCampaigns  AdmissionCampaign[]
  admissionApplications AdmissionApplication[]
  admissionOffers     AdmissionOffer[]

  // Timetable & Scheduling
  academicCalendar   AcademicCalendar[]
  rooms              Room[]
  roomBookings       RoomBooking[]
  bellSchedules      BellSchedule[]
  timetableVersions  TimetableVersion[]
  teacherSubstitutions TeacherSubstitution[]
  temporaryScheduleChanges TemporaryScheduleChange[]

  // Academics Extras
  timetableEntries TimetableEntry[]
  classAssignments ClassAssignment[]

  // Communication
  notifications   Notification[]
  announcements   Announcement[]
  conversations   Conversation[]
  usageLogs       CommunicationUsage[]
  templates       NotificationTemplate[]

  // Maintenance
  maintenanceWindows MaintenanceWindow[]

  // Platform Subscription
  subscription    SchoolSubscription?
  platformInvoices PlatformInvoice[]
  platformPayments PlatformPayment[]

  // Workflow
  workflowInstances WorkflowInstance[]

  // Reporting & Analytics
  reportDefinitions  ReportDefinition[]
  reportExecutions   ReportExecution[]
  reportSchedules    ReportSchedule[]
  analyticsSnapshots AnalyticsSnapshot[]

  // Search
  searchIndexes      SearchIndex[]
  savedSearches      SavedSearch[]
  searchHistory      SearchHistory[]

  // Settings
  schoolSettings     SchoolSetting[]
  featureOverrides   FeatureFlagOverride[]
  numberingRules     NumberingRule[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("schools")
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  EXPIRED
  MAINTENANCE
}

// -----------------------------------------------------------------------------
// IDENTITY & ACCESS
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?   @unique
  passwordHash  String
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")

  isActive      Boolean   @default(true) @map("is_active")

  // Relations
  memberships   SchoolMembership[]
  userRoles     UserRole[]
  studentProfile Student?
  guardianProfile Guardian?
  teacherProfile Teacher?
  staffProfile   Staff?

  notifications     Notification[]
  sentMessages      Message[] @relation("SentMessages")
  messageReceipts   MessageReadStatus[]
  announcements     Announcement[] @relation("AuthorAnnouncements")
  conversationLinks ConversationParticipant[]
  notificationPrefs NotificationPreference[]
  libraryMemberships LibraryMembership[]

  assignedApplications AdmissionApplication[] @relation("AssignedApplications")
  interviews           AdmissionInterview[]
  assessments          AdmissionAssessment[]
  decisions            AdmissionDecision[]

  requestedCorrections ResultCorrectionRequest[] @relation("RequestedCorrections")
  reviewedCorrections  ResultCorrectionRequest[] @relation("ReviewedCorrections")
  invigilatedSessions  ExaminationSession[]
  roomBookings         RoomBooking[]

  reportExecutions     ReportExecution[]
  reportSchedules      ReportSchedule[]

  savedSearches        SavedSearch[]
  searchHistory        SearchHistory[]

  // Preferences & Admin
  userPreferences      UserPreference[]
  platformSettingVersions PlatformSettingVersion[]
  schoolSettingVersions SchoolSettingVersion[]

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  emailVerified DateTime? @map("email_verified")
  phoneVerified DateTime? @map("phone_verified")
  accountState  AccountState @default(PENDING_VERIFICATION) @map("account_state")

  @@map("users")
}

enum AccountState {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  SUSPENDED
  DISABLED
  COMPROMISED
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model Invitation {
  id         String   @id @default(uuid())
  schoolId   String   @map("school_id")
  email      String
  roleId     String   @map("role_id")
  tokenHash  String   @unique @map("token_hash")
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime @map("expires_at")
  invitedById String  @map("invited_by_id")
  createdAt  DateTime @default(now()) @map("created_at")

  school    School @relation(fields: [schoolId], references: [id])
  role      Role   @relation(fields: [roleId], references: [id])

  @@map("invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model SchoolMembership {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  userId    String   @map("user_id")
  status    MembershipStatus @default(ACTIVE)

  school    School   @relation(fields: [schoolId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, userId])
  @@map("school_memberships")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model Role {
  id          String   @id @default(uuid())
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")

  schoolId    String?  @map("school_id")
  school      School?  @relation(fields: [schoolId], references: [id])

  permissions RolePermission[]
  userRoles   UserRole[]
  announcementAudiences AnnouncementAudience[]

  @@unique([name, schoolId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  roleId   String @map("role_id")
  schoolId String? @map("school_id")

  user     User   @relation(fields: [userId], references: [id])
  role     Role   @relation(fields: [roleId], references: [id])
  school   School? @relation(fields: [schoolId], references: [id])

  @@unique([userId, roleId, schoolId])
  @@map("user_roles")
}

// -----------------------------------------------------------------------------
// SCHOOL CORE ENTITIES
// -----------------------------------------------------------------------------

model Student {
  id            String   @id @default(uuid())
  schoolId      String   @map("school_id")
  userId        String?  @unique @map("user_id")

  firstName     String   @map("first_name")
  middleName    String?  @map("middle_name")
  lastName      String   @map("last_name")

  studentNumber String   @map("student_number")
  admissionNumber String? @map("admission_number")
  admissionDate DateTime @map("admission_date")

  dateOfBirth   DateTime @map("date_of_birth")
  gender        String?

  status        StudentStatus @default(ACTIVE)

  school        School   @relation(fields: [schoolId], references: [id])
  user          User?    @relation(fields: [userId], references: [id])

  guardians     StudentGuardian[]
  enrollments   Enrollment[]
  attendance    StudentAttendance[]
  scores        StudentAssessmentScore[]
  subjectResults SubjectResult[]
  overallResults OverallResult[]
  invoices       Invoice[]
  payments        Payment[]
  receipts       Receipt[]
  ledgerEntries  LedgerEntry[]
  adjustments    FinancialAdjustment[]

  transportAssignments TransportAssignment[]
  transportAttendances TransportAttendance[]
  announcementAudiences AnnouncementAudience[]
  classAssignmentSubmissions ClassAssignmentSubmission[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, studentNumber])
  @@unique([schoolId, admissionNumber])
  @@index([schoolId, status])
  @@index([studentNumber])
  @@map("students")
}

enum StudentStatus {
  APPLICANT
  ADMITTED
  ACTIVE
  SUSPENDED
  TRANSFERRED
  GRADUATED
  WITHDRAWN
  DECEASED
}

model Guardian {
  id          String   @id @default(uuid())
  userId      String?  @unique @map("user_id")

  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  email       String?
  phone       String?
  address     String?

  user        User?    @relation(fields: [userId], references: [id])
  students    StudentGuardian[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("guardians")
}

model StudentGuardian {
  studentId  String @map("student_id")
  guardianId String @map("guardian_id")
  relation   String
  isPrimary  Boolean @default(false) @map("is_primary")

  student    Student  @relation(fields: [studentId], references: [id])
  guardian   Guardian @relation(fields: [guardianId], references: [id])

  @@id([studentId, guardianId])
  @@map("student_guardians")
}

model Teacher {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  userId      String?  @unique @map("user_id")

  firstName     String   @map("first_name")
  middleName    String?  @map("middle_name")
  lastName      String   @map("last_name")

  employeeId  String?  @map("employee_id")
  specialization String?
  status      StaffStatus @default(ACTIVE)

  school      School   @relation(fields: [schoolId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])

  departmentId  String? @map("department_id")
  positionId    String? @map("position_id")
  department    Department? @relation("TeacherDepartment", fields: [departmentId], references: [id])
  position      Position?   @relation(fields: [positionId], references: [id])

  assignments TeacherAssignment[]
  attendanceSessions AttendanceSession[]
  timetableEntries TimetableEntry[]
  classAssignments ClassAssignment[]

  employmentRecords StaffEmployment[]
  documents         StaffDocument[]
  qualifications    StaffQualification[]
  certifications    StaffCertification[]
  staffAttendance   StaffAttendance[]
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]
  schedules         StaffSchedule[]
  performanceReviews PerformanceReview[]
  disciplinaryRecords DisciplinaryRecord[]

  onboarding        StaffOnboarding?
  offboarding       StaffOffboarding?

  availability       TeacherAvailability[]
  originalSubstitutions TeacherSubstitution[] @relation("OriginalTeacher")
  substituteSubstitutions TeacherSubstitution[] @relation("SubstituteTeacher")
  temporaryChanges   TemporaryScheduleChange[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, employeeId])
  @@map("teachers")
}

model Staff {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  userId      String?  @unique @map("user_id")

  firstName     String   @map("first_name")
  middleName    String?  @map("middle_name")
  lastName      String   @map("last_name")

  employeeId  String?  @map("employee_id")
  designation String?
  status      StaffStatus @default(ACTIVE)

  school      School   @relation(fields: [schoolId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])
  driver      Driver?

  departmentId  String? @map("department_id")
  positionId    String? @map("position_id")
  department    Department? @relation("StaffDepartment", fields: [departmentId], references: [id])
  position      Position?   @relation(fields: [positionId], references: [id])

  employmentRecords StaffEmployment[]
  documents         StaffDocument[]
  qualifications    StaffQualification[]
  certifications    StaffCertification[]
  staffAttendance   StaffAttendance[]
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]
  schedules         StaffSchedule[]
  performanceReviews PerformanceReview[]
  disciplinaryRecords DisciplinaryRecord[]

  onboarding        StaffOnboarding?
  offboarding       StaffOffboarding?

  temporaryChanges   TemporaryScheduleChange[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, employeeId])
  @@map("staff")
}

enum StaffStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  SUSPENDED
  TERMINATED
  RESIGNED
  RETIRED
  INACTIVE
}

// -----------------------------------------------------------------------------
// ACADEMICS
// -----------------------------------------------------------------------------

model AcademicYear {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  name      String
  code      String
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isCurrent Boolean  @default(false) @map("is_current")
  status    AcademicYearStatus @default(UPCOMING)

  school    School   @relation(fields: [schoolId], references: [id])
  terms     Term[]
  enrollments Enrollment[]
  teacherAssignments TeacherAssignment[]
  attendanceSessions AttendanceSession[]
  assessments        Assessment[]
  subjectResults     SubjectResult[]
  overallResults     OverallResult[]
  feeStructures      FeeStructure[]
  invoices           Invoice[]
  timetableEntries TimetableEntry[]
  classAssignments ClassAssignment[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, code])
  @@map("academic_years")
}

enum AcademicYearStatus {
  DRAFT
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Term {
  id             String   @id @default(uuid())
  academicYearId String   @map("academic_year_id")
  name           String
  code           String
  sequence       Int
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  status         TermStatus @default(UPCOMING)

  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  enrollments    Enrollment[]
  teacherAssignments TeacherAssignment[]
  attendanceSessions AttendanceSession[]
  assessments        Assessment[]
  subjectResults     SubjectResult[]
  overallResults     OverallResult[]
  feeStructures      FeeStructure[]
  invoices           Invoice[]
  timetableEntries   TimetableEntry[]
  classAssignments   ClassAssignment[]

  @@unique([academicYearId, code])
  @@unique([academicYearId, sequence])
  @@map("terms")
}

enum TermStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

model Class {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  name        String
  code        String
  level       Int      @default(0)
  description String?
  isActive    Boolean  @default(true) @map("is_active")

  school      School   @relation(fields: [schoolId], references: [id])
  sections    Section[]
  enrollments Enrollment[]
  classSubjects ClassSubject[]
  attendanceSessions AttendanceSession[]
  assessments   Assessment[]
  subjectResults SubjectResult[]
  overallResults OverallResult[]
  feeStructures FeeStructure[]
  invoices      Invoice[]
  announcementAudiences AnnouncementAudience[]
  timetableEntries TimetableEntry[]
  classAssignments ClassAssignment[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, code])
  @@map("classes")
}

model Section {
  id          String   @id @default(uuid())
  classId     String   @map("class_id")
  name        String
  code        String
  capacity    Int?
  isActive    Boolean  @default(true) @map("is_active")

  class       Class    @relation(fields: [classId], references: [id])
  enrollments Enrollment[]
  teacherAssignments TeacherAssignment[]
  classSubjects      ClassSubject[]
  attendanceSessions AttendanceSession[]
  assessments        Assessment[]
  subjectResults     SubjectResult[]
  overallResults     OverallResult[]
  feeStructures      FeeStructure[]
  invoices           Invoice[]
  announcementAudiences AnnouncementAudience[]
  timetableEntries TimetableEntry[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([classId, code])
  @@map("sections")
}

model Subject {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  name        String
  code        String
  shortName   String?  @map("short_name")
  description String?
  subjectType SubjectType @default(CORE) @map("subject_type")
  isActive    Boolean  @default(true) @map("is_active")

  school      School   @relation(fields: [schoolId], references: [id])
  teacherAssignments TeacherAssignment[]
  classSubjects      ClassSubject[]
  attendanceSessions AttendanceSession[]
  assessments        Assessment[]
  subjectResults     SubjectResult[]
  feeStructures      FeeStructure[]
  invoices           Invoice[]
  timetableEntries TimetableEntry[]
  classAssignments ClassAssignment[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, code])
  @@map("subjects")
}

enum SubjectType {
  CORE
  ELECTIVE
  PRACTICAL
  EXTRACURRICULAR
  OTHER
}

model ClassSubject {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  classId     String   @map("class_id")
  sectionId   String?  @map("section_id")
  subjectId   String   @map("subject_id")

  class       Class    @relation(fields: [classId], references: [id])
  section     Section? @relation(fields: [sectionId], references: [id])
  subject     Subject  @relation(fields: [subjectId], references: [id])

  @@unique([classId, sectionId, subjectId])
  @@map("class_subjects")
}

// -----------------------------------------------------------------------------
// EXAMINATIONS & ASSESSMENTS
// -----------------------------------------------------------------------------

model AssessmentType {
  id          String   @id @default(uuid())
  schoolId    String?  @map("school_id")
  name        String
  code        String
  description String?
  category    AssessmentCategory @default(CONTINUOUS_ASSESSMENT)
  isActive    Boolean  @default(true) @map("is_active")

  school      School?  @relation(fields: [schoolId], references: [id])
  assessments Assessment[]

  @@unique([schoolId, code])
  @@map("assessment_types")
}

enum AssessmentCategory {
  QUIZ
  CLASS_TEST
  ASSIGNMENT
  PROJECT
  PRACTICAL
  ORAL
  MIDTERM
  MOCK
  FINAL_EXAM
  CONTINUOUS_ASSESSMENT
  COURSEWORK
  OTHER
}

model Assessment {
  id               String   @id @default(uuid())
  schoolId         String   @map("school_id")
  academicYearId   String   @map("academic_year_id")
  termId           String?  @map("term_id")
  assessmentTypeId String   @map("assessment_type_id")
  name             String
  code             String
  description      String?
  classId          String   @map("class_id")
  sectionId        String?  @map("section_id")
  subjectId        String   @map("subject_id")
  totalMarks       Float    @map("total_marks")
  weight           Float    @default(1.0)
  startDate        DateTime? @map("start_date")
  endDate          DateTime? @map("end_date")
  status           AssessmentStatus @default(DRAFT)

  examPeriodId     String?        @map("exam_period_id")

  school           School         @relation(fields: [schoolId], references: [id])
  academicYear     AcademicYear   @relation(fields: [academicYearId], references: [id])
  term             Term?          @relation(fields: [termId], references: [id])
  assessmentType   AssessmentType @relation(fields: [assessmentTypeId], references: [id])
  examPeriod       ExaminationPeriod? @relation(fields: [examPeriodId], references: [id])
  class            Class          @relation(fields: [classId], references: [id])
  section          Section?       @relation(fields: [sectionId], references: [id])
  subject          Subject        @relation(fields: [subjectId], references: [id])
  components       AssessmentComponent[]
  scores           StudentAssessmentScore[]

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdBy        String?  @map("created_by")

  @@unique([schoolId, academicYearId, termId, classId, sectionId, subjectId, code])
  @@map("assessments")
}

enum AssessmentStatus {
  DRAFT
  SCHEDULED
  OPEN
  SUBMISSION_OPEN
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  LOCKED
  CANCELLED
}

model AssessmentComponent {
  id            String   @id @default(uuid())
  assessmentId  String   @map("assessment_id")
  name          String
  code          String
  maximumScore  Float    @map("maximum_score")
  weight        Float    @default(1.0)
  sequence      Int      @default(0)

  assessment    Assessment @relation(fields: [assessmentId], references: [id])
  scores        StudentAssessmentScore[]

  @@unique([assessmentId, code])
  @@map("assessment_components")
}

model StudentAssessmentScore {
  id                    String   @id @default(uuid())
  schoolId              String   @map("school_id")
  assessmentId          String   @map("assessment_id")
  assessmentComponentId String?  @map("assessment_component_id")
  studentId             String   @map("student_id")
  enrollmentId          String   @map("enrollment_id")
  rawScore              Float?   @map("raw_score")
  maximumScore          Float    @map("maximum_score")
  percentage            Float?
  status                ScoreStatus @default(NOT_ENTERED)
  remarks               String?
  enteredBy             String?   @map("entered_by")
  enteredAt             DateTime? @map("entered_at")
  updatedBy             String?   @map("updated_by")

  school                School               @relation(fields: [schoolId], references: [id])
  assessment            Assessment           @relation(fields: [assessmentId], references: [id])
  component             AssessmentComponent? @relation(fields: [assessmentComponentId], references: [id])
  student               Student              @relation(fields: [studentId], references: [id])
  enrollment            Enrollment           @relation(fields: [enrollmentId], references: [id])

  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([assessmentId, assessmentComponentId, studentId])
  @@map("student_assessment_scores")
}

model ExaminationPeriod {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  academicYearId  String   @map("academic_year_id")
  termId          String?  @map("term_id")

  name            String
  code            String
  description     String?
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  status          ExamPeriodStatus @default(DRAFT)
  isPublished     Boolean  @default(false) @map("is_published")

  school          School       @relation(fields: [schoolId], references: [id])
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id])
  term            Term?        @relation(fields: [termId], references: [id])

  assessments     Assessment[]
  sessions        ExaminationSession[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, code])
  @@map("examination_periods")
}

enum ExamPeriodStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
  ARCHIVED
}

model ExaminationSession {
  id              String   @id @default(uuid())
  examPeriodId    String   @map("exam_period_id")
  subjectId       String   @map("subject_id")
  classId         String   @map("class_id")
  sectionId       String?  @map("section_id")

  date            DateTime
  startTime       String   @map("start_time")
  endTime         String   @map("end_time")
  roomId          String?  @map("room_id")
  invigilatorId   String?  @map("invigilator_id")

  instructions    String?  @db.Text
  status          ExamSessionStatus @default(SCHEDULED)

  period          ExaminationPeriod @relation(fields: [examPeriodId], references: [id], onDelete: Cascade)
  subject         Subject           @relation(fields: [subjectId], references: [id])
  class           Class             @relation(fields: [classId], references: [id])
  section         Section?          @relation(fields: [sectionId], references: [id])
  room            Room?             @relation(fields: [roomId], references: [id])
  invigilator     User?             @relation(fields: [invigilatorId], references: [id])

  attendance      ExaminationAttendance[]

  @@map("examination_sessions")
}

enum ExamSessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ExaminationAttendance {
  id              String   @id @default(uuid())
  sessionId       String   @map("session_id")
  studentId       String   @map("student_id")
  status          ExamAttendanceStatus @default(PRESENT)
  remarks         String?

  session         ExaminationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student         Student            @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@map("examination_attendance")
}

enum ExamAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  DISQUALIFIED
}

enum ScoreStatus {
  NOT_ENTERED
  ABSENT
  EXCUSED
  EXEMPTED
  DRAFT
  SUBMITTED
  VALIDATED
  APPROVED
  REJECTED
  LOCKED
}

