  assignedDeptId  String?            @map("assigned_dept_id")
  condition       AssetCondition     @default(NEW)
  status          AssetStatus        @default(IN_STORAGE)
  usefulLife      Int?               @map("useful_life")
  residualValue   Decimal?           @map("residual_value") @db.Decimal(19, 4)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  assignments     AssetAssignment[]
  disposal        AssetDisposal?
  maintenance     AssetMaintenance[]
  warranty        AssetWarranty?
  department      Department?        @relation(fields: [assignedDeptId], references: [id])
  staff           Staff?             @relation(fields: [assignedStaffId], references: [id])
  item            InventoryItem?     @relation(fields: [itemId], references: [id])
  location        InventoryLocation? @relation(fields: [locationId], references: [id])
  school          School             @relation(fields: [schoolId], references: [id])
  supplier        Supplier?          @relation(fields: [supplierId], references: [id])

  @@unique([schoolId, assetTag])
  @@map("assets")
}

