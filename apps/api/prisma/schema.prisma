  @@index([schoolId])
  @@index([studentId])
  @@index([status])
  @@map("enrollments")
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  PROMOTED
  TRANSFERRED
  WITHDRAWN
  CANCELLED
}

model TeacherAssignment {
  id             String   @id @default(uuid())
  teacherId      String   @map("teacher_id")
  subjectId      String   @map("subject_id")
  sectionId      String   @map("section_id")
  academicYearId String   @map("academic_year_id")
  termId         String?  @map("term_id")
  status         TeacherAssignmentStatus @default(ACTIVE)
  designation    TeacherDesignation @default(SUBJECT_TEACHER)

  teacher        Teacher      @relation(fields: [teacherId], references: [id])
  subject        Subject      @relation(fields: [subjectId], references: [id])
  section        Section      @relation(fields: [sectionId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  term           Term?        @relation(fields: [termId], references: [id])

  timetableEntries TimetableEntry[]

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([teacherId, subjectId, sectionId, academicYearId, termId])
  @@map("teacher_assignments")
}

enum TeacherAssignmentStatus {
  ACTIVE
  INACTIVE
}

enum TransportAssignmentStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ENDED
  CANCELLED
}

enum TeacherDesignation {
  SUBJECT_TEACHER
  CLASS_TEACHER
  FORM_MASTER
  FORM_MISTRESS
  HEAD_OF_DEPARTMENT
}

// -----------------------------------------------------------------------------
// ATTENDANCE
// -----------------------------------------------------------------------------

model AttendanceSession {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  academicYearId String   @map("academic_year_id")
  termId         String?  @map("term_id")
  date           DateTime @db.Date
  sessionType    AttendanceSessionType @default(DAILY) @map("session_type")
  classId        String   @map("class_id")
  sectionId      String?  @map("section_id")
  subjectId      String?  @map("subject_id")
  teacherId      String?  @map("teacher_id")
  startTime      DateTime? @map("start_time")
  endTime        DateTime? @map("end_time")
  status         AttendanceSessionStatus @default(OPEN)

  school         School       @relation(fields: [schoolId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  term           Term?        @relation(fields: [termId], references: [id])
  class          Class        @relation(fields: [classId], references: [id])
  section        Section?     @relation(fields: [sectionId], references: [id])
  subject        Subject?     @relation(fields: [subjectId], references: [id])
  teacher        Teacher?     @relation(fields: [teacherId], references: [id])
  records        StudentAttendance[]

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by")

  @@unique([schoolId, date, classId, sectionId, subjectId, sessionType])
  @@index([schoolId, date])
  @@map("attendance_sessions")
}

enum AttendanceSessionType {
  DAILY
  MORNING
  AFTERNOON
  SUBJECT
  PERIOD
  EVENT
  OTHER
}

enum AttendanceSessionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  LOCKED
  CANCELLED
}

model StudentAttendance {
  id                  String   @id @default(uuid())
  schoolId            String   @map("school_id")
  attendanceSessionId String   @map("attendance_session_id")
  studentId           String   @map("student_id")
  enrollmentId        String   @map("enrollment_id")
  status              AttendanceStatus @default(PRESENT)
  checkInTime         DateTime? @map("check_in_time")
  checkOutTime        DateTime? @map("check_out_time")
  minutesLate         Int?      @map("minutes_late")
  reason              String?
  remarks             String?
  markedBy            String?   @map("marked_by")
  markedAt            DateTime? @map("marked_at")
  updatedBy           String?   @map("updated_by")

  school              School            @relation(fields: [schoolId], references: [id])
  session             AttendanceSession @relation(fields: [attendanceSessionId], references: [id])
  student             Student           @relation(fields: [studentId], references: [id])
  enrollment          Enrollment        @relation(fields: [enrollmentId], references: [id])

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([attendanceSessionId, studentId])
  @@map("student_attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  AUTHORIZED_ABSENCE
  LEFT_EARLY
}

// -----------------------------------------------------------------------------
// COMMUNICATION & NOTIFICATIONS
// -----------------------------------------------------------------------------

model Notification {
  id               String   @id @default(uuid())
  schoolId         String   @map("school_id")
  userId           String   @map("user_id")

  notificationType String   @map("notification_type")
  templateId       String?  @map("template_id")
  templateVersionId String? @map("template_version_id")
  announcementId   String?  @map("announcement_id")

  title            String
  content          String
  priority         NotificationPriority @default(NORMAL)
  status           NotificationStatus @default(PENDING)

  user             User     @relation(fields: [userId], references: [id])
  school           School   @relation(fields: [schoolId], references: [id])
  template         NotificationTemplate? @relation(fields: [templateId], references: [id])
  templateVersion  NotificationTemplateVersion? @relation(fields: [templateVersionId], references: [id])
  announcement     Announcement? @relation(fields: [announcementId], references: [id])

  deliveries       NotificationDelivery[]

  readAt           DateTime? @map("read_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("notifications")
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

model NotificationDelivery {
  id               String   @id @default(uuid())
  notificationId   String   @map("notification_id")
  channel          CommunicationChannel
  provider         String?
  status           DeliveryStatus @default(PENDING)

  providerRef      String?  @map("provider_ref")
  errorCode        String?  @map("error_code")
  errorMessage     String?  @map("error_message")

  attemptCount     Int      @default(0) @map("attempt_count")
  lastAttemptAt    DateTime? @map("last_attempt_at")
  deliveredAt      DateTime? @map("delivered_at")
  failedAt         DateTime? @map("failed_at")

  notification     Notification @relation(fields: [notificationId], references: [id])

  @@map("notification_deliveries")
}

enum CommunicationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WEBSOCKET
}

enum DeliveryStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  FAILED
}

model NotificationTemplate {
  id               String   @id @default(uuid())
  schoolId         String?  @map("school_id") // Null for platform defaults

  notificationType String   @map("notification_type")
  channel          CommunicationChannel

  isActive         Boolean  @default(true) @map("is_active")

  versions         NotificationTemplateVersion[]
  notifications    Notification[]

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  school           School?  @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, notificationType, channel])
  @@map("notification_templates")
}

model NotificationTemplateVersion {
  id               String   @id @default(uuid())
  templateId       String   @map("template_id")
  version          Int      @default(1)

  subject          String?
  body             String   @db.Text
  variables        Json?

  createdBy        String?  @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")

  template         NotificationTemplate @relation(fields: [templateId], references: [id])
  notifications    Notification[]

  @@unique([templateId, version])
  @@map("notification_template_versions")
}

model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  notificationType String   @map("notification_type")
  channel          CommunicationChannel
  isEnabled        Boolean  @default(true) @map("is_enabled")

  user             User     @relation(fields: [userId], references: [id])

  @@unique([userId, notificationType, channel])
  @@map("notification_preferences")
}

model Announcement {
  id               String   @id @default(uuid())
  schoolId         String?  @map("school_id")
  authorId         String   @map("author_id")

  title            String
  content          String   @db.Text
  priority         NotificationPriority @default(NORMAL)
  status           AnnouncementStatus @default(DRAFT)

  publishAt        DateTime? @map("publish_at")
  expiresAt        DateTime? @map("expires_at")

  school           School?  @relation(fields: [schoolId], references: [id])
  author           User     @relation("AuthorAnnouncements", fields: [authorId], references: [id])

  audiences        AnnouncementAudience[]
  notifications    Notification[]

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("announcements")
}

model AnnouncementAudience {
  id               String   @id @default(uuid())
  announcementId   String   @map("announcement_id")
  audienceType     AudienceType @map("audience_type")

  // Specific targets (nullable)
  roleId           String?  @map("role_id")
  classId          String?  @map("class_id")
  sectionId        String?  @map("section_id")
  studentId        String?  @map("student_id")
  userId           String?  @map("user_id")

  announcement     Announcement @relation(fields: [announcementId], references: [id])
  role             Role?        @relation(fields: [roleId], references: [id])
  class            Class?       @relation(fields: [classId], references: [id])
  section          Section?     @relation(fields: [sectionId], references: [id])
  student          Student?     @relation(fields: [studentId], references: [id])

  @@map("announcement_audiences")
}

enum AudienceType {
  ALL
  TEACHERS
  STUDENTS
  PARENTS
  STAFF
  CLASS
  SECTION
  ROLE
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  EXPIRED
  CANCELLED
}

model Conversation {
  id               String   @id @default(uuid())
  schoolId         String   @map("school_id")
  title            String?
  isGroup          Boolean  @default(false) @map("is_group")

  participants     ConversationParticipant[]
  messages         Message[]

  lastMessageAt    DateTime @default(now()) @map("last_message_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  school           School   @relation(fields: [schoolId], references: [id])

  @@map("conversations")
}

model ConversationParticipant {
  id               String   @id @default(uuid())
  conversationId   String   @map("conversation_id")
  userId           String   @map("user_id")

  conversation     Conversation @relation(fields: [conversationId], references: [id])
  user             User         @relation(fields: [userId], references: [id])

  joinedAt         DateTime @default(now()) @map("joined_at")

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id               String   @id @default(uuid())
  conversationId   String   @map("conversation_id")
  senderId         String   @map("sender_id")

  content          String   @db.Text

  conversation     Conversation @relation(fields: [conversationId], references: [id])
  sender           User         @relation("SentMessages", fields: [senderId], references: [id])
  recipients       MessageReadStatus[]
  attachments      MessageAttachment[]

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("messages")
}

model MessageAttachment {
  id               String   @id @default(uuid())
  messageId        String   @map("message_id")
  fileName         String   @map("file_name")
  fileType         String   @map("file_type")
  fileSize         Int      @map("file_size")
  fileUrl          String   @map("file_url")
  storageKey       String   @map("storage_key")

  message          Message  @relation(fields: [messageId], references: [id])

  createdAt        DateTime @default(now()) @map("created_at")

  @@map("message_attachments")
}

model MessageReadStatus {
  id               String   @id @default(uuid())
  messageId        String   @map("message_id")
  userId           String   @map("user_id")

  isRead           Boolean  @default(false) @map("is_read")
  readAt           DateTime? @map("read_at")

  message          Message  @relation(fields: [messageId], references: [id])
  user             User     @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
  @@map("message_read_status")
}

