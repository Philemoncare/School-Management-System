// -----------------------------------------------------------------------------
// LIBRARY
// -----------------------------------------------------------------------------

model LibraryConfiguration {
  id                String   @id @default(uuid())
  schoolId          String   @unique @map("school_id")

  maxActiveLoans    Int      @default(5) @map("max_active_loans")
  loanDurationDays  Int      @default(14) @map("loan_duration_days")
  maxRenewals       Int      @default(2) @map("max_renewals")
  dailyFineAmount   Decimal  @default(0.50) @db.Decimal(19, 4) @map("daily_fine_amount")
  gracePeriodDays   Int      @default(0) @map("grace_period_days")

  school            School   @relation(fields: [schoolId], references: [id])

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("library_configurations")
}

model BookCategory {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  name        String
  code        String
  description String?

  school      School   @relation(fields: [schoolId], references: [id])
  books       Book[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, code])
  @@map("book_categories")
}

model Author {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  name        String
  biography   String?  @db.Text

  school      School   @relation(fields: [schoolId], references: [id])
  books       BookAuthor[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("authors")
}

model Publisher {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  name        String
  website     String?

  school      School   @relation(fields: [schoolId], references: [id])
  books       Book[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("publishers")
}

model Book {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  title       String
  subtitle    String?
  isbn        String?
  edition     String?
  publicationYear Int? @map("publication_year")
  language    String   @default("English")
  description String?  @db.Text
  coverImage  String?  @map("cover_image")

  categoryId  String?  @map("category_id")
  publisherId String?  @map("publisher_id")

  school      School   @relation(fields: [schoolId], references: [id])
  category    BookCategory? @relation(fields: [categoryId], references: [id])
  publisher   Publisher?    @relation(fields: [publisherId], references: [id])
  authors     BookAuthor[]
  copies      BookCopy[]
  reservations LibraryReservation[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, isbn])
  @@map("books")
}

model BookAuthor {
  bookId   String @map("book_id")
  authorId String @map("author_id")

  book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([bookId, authorId])
  @@map("book_authors")
}

model BookCopy {
  id              String   @id @default(uuid())
  bookId          String   @map("book_id")
  schoolId        String   @map("school_id")
  accessionNumber String   @map("accession_number")
  barcode         String?
  condition       BookCondition @default(NEW)
  status          BookCopyStatus @default(AVAILABLE)

  locationId      String?  @map("location_id")
  shelf           String?

  school          School   @relation(fields: [schoolId], references: [id])
  book            Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  location        LibraryLocation? @relation(fields: [locationId], references: [id])
  loans           LibraryLoan[]
  fines           LibraryFine[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, accessionNumber])
  @@unique([schoolId, barcode])
  @@map("book_copies")
}

enum BookCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum BookCopyStatus {
  AVAILABLE
  BORROWED
  RESERVED
  LOST
  DAMAGED
  MAINTENANCE
  WITHDRAWN
}

model LibraryLocation {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  name        String
  description String?

  school      School   @relation(fields: [schoolId], references: [id])
  copies      BookCopy[]

  @@map("library_locations")
}

model LibraryMembership {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  userId          String   @map("user_id")
  membershipNumber String   @map("membership_number")
  status          MembershipStatus @default(ACTIVE)

  school          School   @relation(fields: [schoolId], references: [id])
  user            User     @relation(fields: [userId], references: [id])
  loans           LibraryLoan[]
  reservations    LibraryReservation[]
  fines           LibraryFine[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, userId])
  @@unique([schoolId, membershipNumber])
  @@map("library_memberships")
}

model LibraryLoan {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  membershipId    String   @map("membership_id")
  bookCopyId      String   @map("book_copy_id")

  loanDate        DateTime @default(now()) @map("loan_date")
  dueDate         DateTime @map("due_date")
  returnDate      DateTime? @map("return_date")
  renewalCount    Int      @default(0) @map("renewal_count")
  status          LoanStatus @default(ACTIVE)

  issuedBy        String?  @map("issued_by")
  returnedBy      String?  @map("returned_by")

  school          School   @relation(fields: [schoolId], references: [id])
  membership      LibraryMembership @relation(fields: [membershipId], references: [id])
  bookCopy        BookCopy @relation(fields: [bookCopyId], references: [id])
  fines           LibraryFine[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("library_loans")
}

enum LoanStatus {
  ACTIVE
  OVERDUE
  RETURNED
  LOST
  CANCELLED
}

model LibraryReservation {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  membershipId    String   @map("membership_id")
  bookId          String   @map("book_id")

  requestDate     DateTime @default(now()) @map("request_date")
  expiryDate      DateTime? @map("expiry_date")
  status          ReservationStatus @default(PENDING)

  school          School   @relation(fields: [schoolId], references: [id])
  membership      LibraryMembership @relation(fields: [membershipId], references: [id])
  book            Book @relation(fields: [bookId], references: [id])

  @@map("library_reservations")
}

enum ReservationStatus {
  PENDING
  READY_FOR_PICKUP
  FULFILLED
  CANCELLED
  EXPIRED
}

model LibraryFine {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  membershipId    String   @map("membership_id")
  loanId          String?  @map("loan_id")
  bookCopyId      String?  @map("book_copy_id")

  amount          Decimal  @db.Decimal(19, 4)
  balance         Decimal  @db.Decimal(19, 4)
  reason          String
  status          FineStatus @default(UNPAID)

  school          School   @relation(fields: [schoolId], references: [id])
  membership      LibraryMembership @relation(fields: [membershipId], references: [id])
  loan            LibraryLoan? @relation(fields: [loanId], references: [id])
  bookCopy        BookCopy? @relation(fields: [bookCopyId], references: [id])

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("library_fines")
}

enum FineStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  WAIVED
}

// -----------------------------------------------------------------------------
// TRANSPORT
// -----------------------------------------------------------------------------

model Vehicle {
  id                String   @id @default(uuid())
  schoolId          String   @map("school_id")
  registrationNumber String  @map("registration_number")
  make              String?
  model             String?
  year              Int?
  type              String?
  seatingCapacity   Int      @map("seating_capacity")
  status            VehicleStatus @default(AVAILABLE)

  currentMileage    Float?   @map("current_mileage")
  acquisitionDate   DateTime? @map("acquisition_date")
  acquisitionCost   Decimal?  @db.Decimal(19, 4) @map("acquisition_cost")
  insuranceNumber   String?   @map("insurance_number")
  insuranceExpiry   DateTime? @map("insurance_expiry")
  notes             String?   @db.Text

  school            School   @relation(fields: [schoolId], references: [id])
  driverAssignments VehicleDriverAssignment[]
  maintenanceRecords VehicleMaintenance[]
  documents         VehicleDocument[]
  fuelRecords       FuelRecord[]
  trips             TransportTrip[]
  assignments       TransportAssignment[]

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, registrationNumber])
  @@map("vehicles")
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  IN_SERVICE
  ON_TRIP
  MAINTENANCE
  OUT_OF_SERVICE
  RETIRED
}

model Driver {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  staffId         String   @unique @map("staff_id")
  licenseNumber   String   @map("license_number")
  licenseClass    String   @map("license_class")
  licenseExpiry   DateTime @map("license_expiry")
  status          DriverStatus @default(ACTIVE)
  notes           String?  @db.Text

  school          School   @relation(fields: [schoolId], references: [id])
  staff           Staff    @relation(fields: [staffId], references: [id])
  vehicleAssignments VehicleDriverAssignment[]
  trips           TransportTrip[]
  documents       DriverDocument[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("drivers")
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ON_LEAVE
  TERMINATED
}

model VehicleDriverAssignment {
  id        String   @id @default(uuid())
  vehicleId String   @map("vehicle_id")
  driverId  String   @map("driver_id")
  isPrimary Boolean  @default(true) @map("is_primary")

  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, driverId])
  @@map("vehicle_driver_assignments")
}

model Route {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  name            String
  code            String?
  description     String?
  direction       RouteDirection @default(ROUND_TRIP)
  estimatedDuration Int?     @map("estimated_duration")
  estimatedDistance Float?   @map("estimated_distance")
  status          RouteStatus @default(ACTIVE)

  school          School   @relation(fields: [schoolId], references: [id])
  stops           RouteStop[]
  schedules       TransportSchedule[]
  trips           TransportTrip[]
  assignments     TransportAssignment[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, name])
  @@map("routes")
}

enum RouteDirection {
  PICKUP
  DROP_OFF
  ROUND_TRIP
}

enum RouteStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

model RouteStop {
  id              String   @id @default(uuid())
  routeId         String   @map("route_id")
  name            String
  address         String?
  latitude        Float?
  longitude       Float?
  sequence        Int
  estimatedArrivalTime String? @map("estimated_arrival_time")

  route           Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  pickupAssignments TransportAssignment[] @relation("PickupStop")
  dropoffAssignments TransportAssignment[] @relation("DropoffStop")
  attendances     TransportAttendance[]

  @@unique([routeId, sequence])
  @@map("route_stops")
}

model TransportSchedule {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  routeId         String   @map("route_id")
  vehicleId       String?  @map("vehicle_id")
  driverId        String?  @map("driver_id")

  type            ScheduleType @default(REGULAR)
  daysOfWeek      Int[]    @map("days_of_week")
  startTime       String   @map("start_time")
  endTime         String?  @map("end_time")

  school          School   @relation(fields: [schoolId], references: [id])
  route           Route    @relation(fields: [routeId], references: [id])
