model AdmissionCampaign {
  id                String   @id @default(uuid())
  schoolId          String   @map("school_id")
  academicYearId    String   @map("academic_year_id")
  name              String
  slug              String
  description       String?  @db.Text

  startDate         DateTime @map("start_date")
  endDate           DateTime @map("end_date")
  applicationOpenDate DateTime @map("application_open_date")
  applicationCloseDate DateTime @map("application_close_date")

  status            CampaignStatus @default(DRAFT)
  applicationFee    Decimal? @db.Decimal(19, 4) @map("application_fee")
  instructions      String?  @db.Text

  school            School       @relation(fields: [schoolId], references: [id])
  academicYear      AcademicYear @relation(fields: [academicYearId], references: [id])
  applications      AdmissionApplication[]
  waitlist          AdmissionWaitlist[]

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, slug])
  @@map("admission_campaigns")
}

enum CampaignStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
  ARCHIVED
}

model AdmissionApplication {
  id                String   @id @default(uuid())
  schoolId          String   @map("school_id")
  campaignId        String   @map("campaign_id")
  reference         String   @map("reference") // APP-2027-000001

  // Applicant Info
  firstName         String   @map("first_name")
  middleName        String?  @map("middle_name")
  lastName          String   @map("last_name")
  dateOfBirth       DateTime @map("date_of_birth")
  gender            String?

  // Requested Placement
  academicYearId    String   @map("academic_year_id")
  classId           String   @map("class_id")

  status            ApplicationStatus @default(SUBMITTED)
  submissionDate    DateTime @default(now()) @map("submission_date")

  // Linking
  studentId         String?  @map("student_id") // Link after admission

  assignedToId      String?  @map("assigned_to_id")

  school            School            @relation(fields: [schoolId], references: [id])
  campaign          AdmissionCampaign @relation(fields: [campaignId], references: [id])
  academicYear      AcademicYear      @relation(fields: [academicYearId], references: [id])
  class             Class             @relation(fields: [classId], references: [id])
  assignedTo        User?             @relation("AssignedApplications", fields: [assignedToId], references: [id])

  documents         AdmissionApplicationDocument[]
  interviews        AdmissionInterview[]
  assessments       AdmissionAssessment[]
  decisions         AdmissionDecision[]
  offers            AdmissionOffer[]
  guardians         AdmissionApplicationGuardian[]

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, reference])
  @@map("admission_applications")
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  DOCUMENTS_REQUIRED
  SCREENING
  INTERVIEW_SCHEDULED
  ASSESSMENT_PENDING
  ASSESSMENT_COMPLETED
  DECISION_PENDING
  OFFERED
  ACCEPTED
  REJECTED
  WAITLISTED
  WITHDRAWN
  EXPIRED
  ADMITTED
  ENROLLED
}

model AdmissionApplicationGuardian {
  id                String   @id @default(uuid())
  applicationId     String   @map("application_id")
  firstName         String   @map("first_name")
  lastName          String   @map("last_name")
  relationship      String
  email             String
  phone             String
  address           String?
  isPrimary         Boolean  @default(false) @map("is_primary")

  application       AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("admission_application_guardians")
}

model AdmissionApplicationDocument {
  id                String   @id @default(uuid())
  applicationId     String   @map("application_id")
  documentType      String   @map("document_type")
  title             String
  fileUrl           String   @map("file_url")
  storageKey        String   @map("storage_key")
  isRequired        Boolean  @default(true) @map("is_required")

  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  rejectionReason   String?  @map("rejection_reason")
  verifiedById      String?  @map("verified_by_id")
  verifiedAt        DateTime? @map("verified_at")

  application       AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("admission_application_documents")
}

model AdmissionInterview {
  id                String   @id @default(uuid())
  applicationId     String   @map("application_id")
  interviewerId     String   @map("interviewer_id")
  scheduledDate     DateTime @map("scheduled_date")
  location          String?
  status            InterviewStatus @default(SCHEDULED)
  notes             String?  @db.Text
  rating            Int?
  recommendation    String?

  application       AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer       User                 @relation(fields: [interviewerId], references: [id])

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("admission_interviews")
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  MISSED
  RESCHEDULED
}

model AdmissionAssessment {
  id                String   @id @default(uuid())
  applicationId     String   @map("application_id")
  subject           String
  assessmentDate    DateTime @map("assessment_date")
  maxScore          Float    @map("max_score")
  score             Float?
  result            String?
  evaluatorId       String   @map("evaluator_id")
  status            String   @default("PENDING")
  comments          String?  @db.Text

  application       AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  evaluator         User                 @relation(fields: [evaluatorId], references: [id])

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("admission_assessments")
}

model AdmissionDecision {
  id                String   @id @default(uuid())
  applicationId     String   @map("application_id")
  decision          DecisionType
  reason            String?  @db.Text
  decisionMakerId   String   @map("decision_maker_id")
  decisionDate      DateTime @default(now()) @map("decision_date")
  notes             String?  @db.Text

  application       AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  decisionMaker     User                 @relation(fields: [decisionMakerId], references: [id])

  createdAt         DateTime @default(now()) @map("created_at")

  @@map("admission_decisions")
}

enum DecisionType {
  ADMIT
  REJECT
  WAITLIST
  DEFER
  REQUEST_MORE_INFORMATION
}

model AdmissionOffer {
  id                String   @id @default(uuid())
  applicationId     String   @map("application_id")
  schoolId          String   @map("school_id")
  reference         String   @unique // OFF-2027-000001

  academicYearId    String   @map("academic_year_id")
  classId           String   @map("class_id")

  offerDate         DateTime @default(now()) @map("offer_date")
  expiryDate        DateTime @map("expiry_date")
  status            OfferStatus @default(ISSUED)
  conditions        String?  @db.Text
  acceptanceDate    DateTime? @map("acceptance_date")

  application       AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  school            School               @relation(fields: [schoolId], references: [id])
  academicYear      AcademicYear         @relation(fields: [academicYearId], references: [id])
  class             Class                @relation(fields: [classId], references: [id])

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("admission_offers")
}

enum OfferStatus {
  DRAFT
  ISSUED
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

model AdmissionWaitlist {
  id                String   @id @default(uuid())
  campaignId        String   @map("campaign_id")
  applicationId     String   @unique @map("application_id")
  classId           String   @map("class_id")
  priority          Int      @default(0)
  status            String   @default("ACTIVE")
  notes             String?  @db.Text

  campaign          AdmissionCampaign @relation(fields: [campaignId], references: [id])
  application       AdmissionApplication @relation(fields: [applicationId], references: [id])
  class             Class             @relation(fields: [classId], references: [id])

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("admission_waitlist")
}

// -----------------------------------------------------------------------------
// WORKFLOW & ORCHESTRATION
// -----------------------------------------------------------------------------

model DomainEvent {
  id              String   @id @default(uuid())
  schoolId        String?  @map("school_id")
  eventType       String   @map("event_type")
  eventVersion    Int      @default(1) @map("event_version")
  actorUserId     String?  @map("actor_user_id")
  resourceType    String   @map("resource_type")
  resourceId      String   @map("resource_id")
  correlationId   String?  @map("correlation_id")
  causationId     String?  @map("causation_id")
  timestamp       DateTime @default(now())
  payload         Json
  metadata        Json?

  processingRecords EventProcessingRecord[]

  @@index([schoolId])
  @@index([correlationId])
  @@map("domain_events")
}

model EventProcessingRecord {
  id              String   @id @default(uuid())
  eventId         String   @map("event_id")
  handlerName     String   @map("handler_name")
  status          ProcessingStatus @default(PENDING)
  processedAt     DateTime? @map("processed_at")
  retryCount      Int      @default(0) @map("retry_count")
  errorInfo       String?  @map("error_info") @db.Text

  event           DomainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, handlerName])
  @@map("event_processing_records")
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model WorkflowInstance {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  workflowType    String   @map("workflow_type")
  status          WorkflowStatus @default(PENDING)
  context         Json?    // Current workflow data

  correlationId   String?  @map("correlation_id")
  causationId     String?  @map("causation_id")

  school          School   @relation(fields: [schoolId], references: [id])
  steps           WorkflowStep[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([schoolId])
  @@index([correlationId])
  @@map("workflow_instances")
}

enum WorkflowStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  RETRYING
  CANCELLED
  REQUIRES_ACTION
}

model WorkflowStep {
  id              String   @id @default(uuid())
  workflowInstanceId String @map("workflow_instance_id")
  name            String
  status          StepStatus @default(PENDING)
  order           Int

  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  errorInfo       String?  @map("error_info") @db.Text
  metadata        Json?

  workflowInstance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)

  @@unique([workflowInstanceId, name])
  @@map("workflow_steps")
}

enum StepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  SKIPPED
}

model OutboxEvent {
  id              String   @id @default(uuid())
  schoolId        String?  @map("school_id")
  eventType       String   @map("event_type")
  payload         Json
  metadata        Json?

  status          OutboxStatus @default(PENDING)
  processedAt     DateTime? @map("processed_at")
  error           String?   @db.Text

  createdAt       DateTime @default(now()) @map("created_at")

  @@index([status])
  @@map("outbox_events")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// -----------------------------------------------------------------------------
// REPORTING & ANALYTICS
// -----------------------------------------------------------------------------

model ReportDefinition {
  id              String   @id @default(uuid())
  schoolId        String?  @map("school_id") // Null for platform defaults
  name            String
  code            String
  description     String?  @db.Text
  category        ReportCategory
  visibility      ReportVisibility @default(PRIVATE)
  requiredPermission String?     @map("required_permission")

  datasetId       String?  @map("dataset_id")
  dataset         ReportDataset? @relation(fields: [datasetId], references: [id])

  currentVersion  Int      @default(1) @map("current_version")
  status          ReportStatus @default(ACTIVE)

  school          School?  @relation(fields: [schoolId], references: [id])
  versions        ReportVersion[]
  executions      ReportExecution[]
  schedules       ReportSchedule[]
  snapshots       AnalyticsSnapshot[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, code])
  @@map("report_definitions")
}

model ReportVersion {
  id                String   @id @default(uuid())
  reportDefinitionId String  @map("report_definition_id")
  version           Int
  config            Json     // columns, sorting, grouping, chart options, filters
  changeDescription String?  @map("change_description")
  createdById       String   @map("created_by_id")

  reportDefinition  ReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)
  createdBy         User             @relation(fields: [createdById], references: [id])

  createdAt         DateTime @default(now()) @map("created_at")

  executions        ReportExecution[]

  @@unique([reportDefinitionId, version])
  @@map("report_versions")
}

model ReportDataset {
  id              String   @id @default(uuid())
  name            String   @unique
  code            String   @unique
  description     String?  @db.Text
  category        ReportCategory
  baseModel       String   @map("base_model") // e.g., "Student", "Invoice"

  fields          ReportField[]
  reportDefinitions ReportDefinition[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("report_datasets")
}

model ReportField {
  id              String   @id @default(uuid())
  datasetId       String   @map("dataset_id")
  name            String
  code            String
  dataType        String   @map("data_type") // STRING, NUMBER, DATE, BOOLEAN
  isSensitive     Boolean  @default(false) @map("is_sensitive")
  requiredPermission String? @map("required_permission")

  dataset         ReportDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, code])
  @@map("report_fields")
}

enum ReportCategory {
  ACADEMIC
  STUDENTS
  ATTENDANCE
  EXAMINATIONS
  RESULTS
  ADMISSIONS
  FINANCE
  STAFF
  HR
  OPERATIONS
  PLATFORM
  CUSTOM
}

enum ReportVisibility {
  PUBLIC
  PRIVATE
  INTERNAL
}

enum ReportStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model ReportExecution {
  id                String   @id @default(uuid())
  schoolId          String   @map("school_id")
  reportDefinitionId String  @map("report_definition_id")
  reportVersionId   String?  @map("report_version_id")
  executedById      String   @map("executed_by_id")

  parameters        Json?    // filters used
  status            ExecutionStatus @default(PENDING)
  format            ExportFormat @default(PDF)
  fileUrl           String?  @map("file_url")
  error             String?  @db.Text

  durationMs        Int?     @map("duration_ms")
  expiresAt         DateTime? @map("expires_at")

  school            School           @relation(fields: [schoolId], references: [id])
  reportDefinition  ReportDefinition @relation(fields: [reportDefinitionId], references: [id])
  reportVersion     ReportVersion?   @relation(fields: [reportVersionId], references: [id])
  executedBy        User             @relation(fields: [executedById], references: [id])

  createdAt         DateTime @default(now()) @map("created_at")

  @@map("report_executions")
}

enum ExecutionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum ExportFormat {
  PDF
  EXCEL
  CSV
  JSON
}

model ReportSchedule {
  id                String   @id @default(uuid())
  schoolId          String   @map("school_id")
  reportDefinitionId String  @map("report_definition_id")
  createdById       String   @map("created_by_id")

  frequency         ScheduleFrequency
  time              String   // "HH:mm"
  dayOfWeek         Int?     @map("day_of_week")
  dayOfMonth        Int?     @map("day_of_month")
  timezone          String   @default("UTC")

  parameters        Json?
  format            ExportFormat @default(PDF)
  isActive          Boolean  @default(true) @map("is_active")

  recipients        ReportScheduleRecipient[]

  school            School           @relation(fields: [schoolId], references: [id])
  reportDefinition  ReportDefinition @relation(fields: [reportDefinitionId], references: [id])
  createdBy         User             @relation(fields: [createdById], references: [id])

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("report_schedules")
}

enum ScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  TERMLY
  ANNUALLY
}

model ReportScheduleRecipient {
  id              String   @id @default(uuid())
  scheduleId      String   @map("schedule_id")
  recipientType   RecipientType
  recipientId     String?  @map("recipient_id") // userId or roleId
  email           String?  // For external recipients

  schedule        ReportSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("report_schedule_recipients")
}

enum RecipientType {
  USER
  ROLE
  DEPARTMENT
  EMAIL
}

model AnalyticsSnapshot {
  id                String   @id @default(uuid())
  schoolId          String   @map("school_id")
  reportDefinitionId String? @map("report_definition_id")
  metricName        String   @map("metric_name")
  metricValue       Decimal  @db.Decimal(19, 4) @map("metric_value")

  dimension1        String?  @map("dimension_1") // e.g. "Class ID"
  dimension2        String?  @map("dimension_2") // e.g. "Subject ID"

  periodStart       DateTime @map("period_start")
  periodEnd         DateTime @map("period_end")
  granularity       String   // DAILY, MONTHLY, etc.

  school            School           @relation(fields: [schoolId], references: [id])
  reportDefinition  ReportDefinition? @relation(fields: [reportDefinitionId], references: [id])

  createdAt         DateTime @default(now()) @map("created_at")

  @@index([schoolId, metricName, periodStart])
  @@map("analytics_snapshots")
}

// -----------------------------------------------------------------------------
// SEARCH & DISCOVERY
// -----------------------------------------------------------------------------

model SearchIndex {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  entityId        String   @map("entity_id")
  entityType      SearchableEntityType @map("entity_type")

  title           String   @db.Text
  subtitle        String?  @db.Text
  content         String?  @db.Text // Denormalized searchable tokens

  status          String?  // e.g., ACTIVE, ARCHIVED, PAID
  module          String   // e.g., FINANCE, STUDENTS

  metadata        Json?    // Non-sensitive data for display

  school          School   @relation(fields: [schoolId], references: [id])

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, entityType, entityId])
  @@index([schoolId])
  @@index([title])
  @@index([content])
  @@map("search_index")
}

enum SearchableEntityType {
  STUDENT
  TEACHER
  STAFF
  GUARDIAN
  ADMISSION_APPLICATION
  CLASS
  SECTION
  SUBJECT
  ACADEMIC_YEAR
  TERM
  ASSESSMENT
  EXAMINATION
  RESULT
  INVOICE
  PAYMENT
  RECEIPT
  LIBRARY_BOOK
  LIBRARY_COPY
  LIBRARY_LOAN
  TRANSPORT_ROUTE
  TRANSPORT_VEHICLE
  DOCUMENT
  ANNOUNCEMENT
  CONVERSATION
  WORKFLOW
  USER
  SCHOOL
  SUBSCRIPTION
  PLAN
}

model SavedSearch {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  userId          String   @map("user_id")
  name            String
  query           String?
  filters         Json?
  entityScope     SearchableEntityType[] @map("entity_scope")

  school          School   @relation(fields: [schoolId], references: [id])
  user            User     @relation(fields: [userId], references: [id])

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("saved_searches")
}

model SearchHistory {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  userId          String   @map("user_id")
  query           String
  scope           String?  // GLOBAL or specific module

  school          School   @relation(fields: [schoolId], references: [id])
  user            User     @relation(fields: [userId], references: [id])

  createdAt       DateTime @default(now()) @map("created_at")

  @@map("search_history")
}

// -----------------------------------------------------------------------------
// ENTERPRISE SECURITY & COMPLIANCE
// -----------------------------------------------------------------------------

model UserSession {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  schoolId        String?   @map("school_id") // Active school context for this session

  tokenHash       String    @unique @map("token_hash") // Hashed session token

  // Device/Environment info
  deviceId        String?   @map("device_id")
  ipAddress       String?   @map("ip_address")
  userAgent       String?   @map("user_agent")
  browser         String?
  os              String?

  // Status
  status          SessionStatus @default(ACTIVE)
  riskScore       Float         @default(0) @map("risk_score")

  // Timestamps
  lastSeenAt      DateTime      @default(now()) @map("last_seen_at")
  expiresAt       DateTime      @map("expires_at")
  revokedAt       DateTime?     @map("revoked_at")
  revokeReason    String?       @map("revoke_reason")

  user            User          @relation(fields: [userId], references: [id])
  device          UserDevice?   @relation(fields: [deviceId], references: [id])
  securityEvents  SecurityEvent[]

  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([userId])
  @@map("user_sessions")
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
  SUSPENDED
}

model UserDevice {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")

  deviceIdentifier String   @map("device_identifier") // Unique fingerprint
  deviceName      String?   @map("device_name")
  deviceType      String?   @map("device_type")

  isTrusted       Boolean   @default(false) @map("is_trusted")
  lastIp          String?   @map("last_ip")
  lastSeenAt      DateTime  @default(now()) @map("last_seen_at")

  user            User      @relation(fields: [userId], references: [id])
  sessions        UserSession[]

  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([userId, deviceIdentifier])
  @@map("user_devices")
}

model MfaMethod {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")

  type            MfaType
  status          MfaStatus @default(PENDING_VERIFICATION)

  secret          String?   // Encrypted TOTP secret
  phoneNumber     String?   @map("phone_number")

  isDefault       Boolean   @default(false) @map("is_default")
  verifiedAt      DateTime? @map("verified_at")

  user            User      @relation(fields: [userId], references: [id])
  challenges      MfaChallenge[]

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("mfa_methods")
}

enum MfaType {
  TOTP
  SMS
  EMAIL
  WEBAUTHN
  RECOVERY_CODE
}

enum MfaStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

model MfaChallenge {
  id              String    @id @default(uuid())
  mfaMethodId     String    @map("mfa_method_id")

  code            String?   // Hashed code if applicable
  status          ChallengeStatus @default(PENDING)
  expiresAt       DateTime  @map("expires_at")

  method          MfaMethod @relation(fields: [mfaMethodId], references: [id])

  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("mfa_challenges")
}

enum ChallengeStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
}

model SecurityEvent {
  id              String    @id @default(uuid())
  schoolId        String?   @map("school_id")
  userId          String?   @map("user_id")
  sessionId       String?   @map("session_id")

  eventType       SecurityEventType @map("event_type")
  severity        SecuritySeverity  @default(LOW)

  ipAddress       String?   @map("ip_address")
  userAgent       String?   @map("user_agent")

  resourceType    String?   @map("resource_type")
  resourceId      String?   @map("resource_id")

  metadata        Json?
  riskScore       Float?    @map("risk_score")

  user            User?     @relation(fields: [userId], references: [id])
  session         UserSession? @relation(fields: [sessionId], references: [id])
  school          School?   @relation(fields: [schoolId], references: [id])

  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([schoolId])
  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@index([severity])
  @@map("security_events")
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  MFA_ENABLED
  MFA_DISABLED
  MFA_VERIFICATION_FAILED
  SESSION_REVOKED
  ACCOUNT_LOCKED
  PERMISSION_DENIED
  CROSS_TENANT_ACCESS_ATTEMPT
  SUSPICIOUS_ACTIVITY
  API_ABUSE
  SENSITIVE_DATA_EXPORT
  SECURITY_POLICY_CHANGED
  ADMIN_IMPERSONATION_STARTED
  ADMIN_IMPERSONATION_ENDED
  FILE_MALWARE_DETECTED
  WEBHOOK_VERIFICATION_FAILED
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model SecurityIncident {
  id              String    @id @default(uuid())
  schoolId        String?   @map("school_id")

  title           String
  description     String?   @db.Text
  status          IncidentStatus @default(OPEN)
  severity        SecuritySeverity @default(MEDIUM)

  detectedAt      DateTime  @default(now()) @map("detected_at")
  resolvedAt      DateTime? @map("resolved_at")

  assignedToId    String?   @map("assigned_to_id")

  school          School?   @relation(fields: [schoolId], references: [id])

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("security_incidents")
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  CONTAINED
  RESOLVED
  CLOSED
}

model SecurityPolicy {
  id              String    @id @default(uuid())
  schoolId        String?   @unique @map("school_id") // Null for platform default

  passwordMinLength    Int      @default(8) @map("password_min_length")
  passwordRequireUpper Boolean  @default(true) @map("password_require_upper")
  passwordRequireNumber Boolean @default(true) @map("password_require_number")
  passwordRequireSymbol Boolean @default(true) @map("password_require_symbol")

  mfaEnforcement       MfaEnforcement @default(OPTIONAL) @map("mfa_enforcement")
  sessionTimeoutMinutes Int     @default(60) @map("session_timeout_minutes")
  idleTimeoutMinutes    Int     @default(15) @map("idle_timeout_minutes")
  maxConcurrentSessions Int     @default(5) @map("max_concurrent_sessions")

  lockoutThreshold      Int     @default(5) @map("lockout_threshold")
  lockoutDurationMinutes Int    @default(30) @map("lockout_duration_minutes")

  school          School?   @relation(fields: [schoolId], references: [id])

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("security_policies")
}

enum MfaEnforcement {
  OPTIONAL
  REQUIRED_FOR_ADMINS
  REQUIRED_FOR_ALL
}

model PrivacyRequest {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  schoolId        String    @map("school_id")

  type            PrivacyRequestType
  status          PrivacyRequestStatus @default(REQUESTED)

  reason          String?   @db.Text
  adminNotes      String?   @map("admin_notes") @db.Text

  user            User      @relation(fields: [userId], references: [id])
  school          School    @relation(fields: [schoolId], references: [id])

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("privacy_requests")
}

enum PrivacyRequestType {
  ACCESS
  EXPORT
  CORRECTION
  DELETION
}

enum PrivacyRequestStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

model RetentionPolicy {
  id              String    @id @default(uuid())
  schoolId        String?   @map("school_id")

  entityType      String    @map("entity_type") // e.g., "AUDIT_LOG", "NOTIFICATION"
  retentionDays   Int       @map("retention_days")

  school          School?   @relation(fields: [schoolId], references: [id])

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([schoolId, entityType])
  @@map("retention_policies")
}

